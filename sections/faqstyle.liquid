{% comment %}
  FAQ générale — responsive PC/mobile
  Ajout : Boutique en ligne > Thèmes > Modifier le code > sections/faq-site-responsive.liquid
{% endcomment %}

{% if section.settings.faq_font == 'manrope' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endif %}

<section id="faq-{{ section.id }}" class="faq-site" style="
  --faq-bg: {{ section.settings.bg_color }};
  --faq-title-color: {{ section.settings.title_color }};
  --faq-category-color: {{ section.settings.category_color }};
  --faq-question-color: {{ section.settings.question_color }};
  --faq-answer-color: {{ section.settings.answer_color }};
  --faq-divider: {{ section.settings.divider_color }};
  --faq-width: {{ section.settings.max_width }}px;
  --faq-cols-gap: {{ section.settings.columns_gap }}px;
  --faq-group-gap: {{ section.settings.groups_gap }}px;
  --faq-title-size: {{ section.settings.title_size }}px;
  --faq-category-size: {{ section.settings.category_size }}px;
  --faq-question-size: {{ section.settings.question_size }}px;
  --faq-answer-size: {{ section.settings.answer_size }}px;
  --faq-title-size-m: {{ section.settings.title_size_mobile }}px;
  --faq-category-size-m: {{ section.settings.category_size_mobile }}px;
  --faq-question-size-m: {{ section.settings.question_size_mobile }}px;
  --faq-answer-size-m: {{ section.settings.answer_size_mobile }}px;
  --faq-row-y: {{ section.settings.row_padding }}px;
  --faq-row-y-m: {{ section.settings.row_padding_mobile }}px;
  --faq-pad-top: {{ section.settings.padding_top }}px;
  --faq-pad-bottom: {{ section.settings.padding_bottom }}px;
  --faq-pad-x: {{ section.settings.padding_sides }}px;
  --faq-pad-top-m: {{ section.settings.padding_top_mobile }}px;
  --faq-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  --faq-pad-x-m: {{ section.settings.padding_sides_mobile }}px;
  --faq-icon-size: {{ section.settings.icon_size }}px;
">
  <div class="faq-site__inner">
    {% if section.settings.title != blank %}
      <h2 class="faq-site__title">{{ section.settings.title | escape }}</h2>
    {% endif %}

    {% assign faq_groups = 'livraison,paiement,garantie,produits' | split: ',' %}
    <div class="faq-site__groups">
      {% for faq_group in faq_groups %}
        {% case faq_group %}
          {% when 'livraison' %}
            {% assign group_heading = section.settings.group_livraison %}
          {% when 'paiement' %}
            {% assign group_heading = section.settings.group_paiement %}
          {% when 'garantie' %}
            {% assign group_heading = section.settings.group_garantie %}
          {% when 'produits' %}
            {% assign group_heading = section.settings.group_produits %}
        {% endcase %}

        {% assign questions_in_group = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'question' and block.settings.category == faq_group and block.settings.question != blank %}
            {% assign questions_in_group = questions_in_group | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if questions_in_group > 0 %}
          <div class="faq-site__group">
            {% if group_heading != blank %}
              <h3 class="faq-site__category">{{ group_heading | escape }}</h3>
            {% endif %}
            <div class="faq-site__questions">
              {% for block in section.blocks %}
                {% if block.type == 'question' and block.settings.category == faq_group and block.settings.question != blank %}
                  <details class="faq-site__item" {{ block.shopify_attributes }}>
                    <summary class="faq-site__question">
                      <span>{{ block.settings.question | escape }}</span>
                      <svg class="faq-site__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </summary>
                    <div class="faq-site__answer rte">{{ block.settings.answer }}</div>
                  </details>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #faq-{{ section.id }} {
    width: 100%;
    background: var(--faq-bg);
    padding: var(--faq-pad-top) var(--faq-pad-x) var(--faq-pad-bottom);
    {% if section.settings.faq_font == 'manrope' %}
      font-family: 'Manrope', sans-serif;
    {% else %}
      font-family: inherit;
    {% endif %}
  }
  #faq-{{ section.id }} *,
  #faq-{{ section.id }} *::before,
  #faq-{{ section.id }} *::after { box-sizing: border-box; }

  #faq-{{ section.id }} .faq-site__inner {
    width: 100%;
    max-width: var(--faq-width);
    margin: 0 auto;
  }
  #faq-{{ section.id }} .faq-site__title {
    color: var(--faq-title-color);
    font-family: inherit;
    font-size: var(--faq-title-size);
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.2;
    letter-spacing: -0.035em;
    text-align: {{ section.settings.title_alignment }};
    margin: 0 0 {{ section.settings.title_spacing }}px;
  }
  #faq-{{ section.id }} .faq-site__groups {
    display: flex;
    flex-direction: column;
    gap: var(--faq-group-gap);
  }
  #faq-{{ section.id }} .faq-site__category {
    color: var(--faq-category-color);
    font-family: inherit;
    font-size: var(--faq-category-size);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 {{ section.settings.category_spacing }}px;
  }
  #faq-{{ section.id }} .faq-site__questions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--faq-cols-gap);
    align-items: start;
  }
  #faq-{{ section.id }} .faq-site__item {
    min-width: 0;
    border-top: 1px solid var(--faq-divider);
    border-bottom: 1px solid var(--faq-divider);
    margin-top: -1px;
  }
  #faq-{{ section.id }} .faq-site__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: var(--faq-row-y) 10px var(--faq-row-y) 0;
    color: var(--faq-question-color);
    font-family: inherit;
    font-size: var(--faq-question-size);
    font-weight: 500;
    line-height: 1.45;
    list-style: none;
    cursor: pointer;
  }
  #faq-{{ section.id }} .faq-site__question::-webkit-details-marker { display: none; }
  #faq-{{ section.id }} .faq-site__question::marker { content: ''; }
  #faq-{{ section.id }} .faq-site__question:focus-visible {
    outline: 2px solid var(--faq-question-color);
    outline-offset: 3px;
  }
  #faq-{{ section.id }} .faq-site__chevron {
    width: var(--faq-icon-size);
    height: var(--faq-icon-size);
    flex: 0 0 var(--faq-icon-size);
    transition: transform .22s ease;
  }
  #faq-{{ section.id }} .faq-site__item[open] .faq-site__chevron { transform: rotate(180deg); }
  #faq-{{ section.id }} .faq-site__answer {
    color: var(--faq-answer-color);
    font-family: inherit;
    font-size: var(--faq-answer-size);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 22px 18px 0;
    overflow-wrap: anywhere;
  }
  #faq-{{ section.id }} .faq-site__answer p { margin: 0 0 10px; }
  #faq-{{ section.id }} .faq-site__answer p:last-child { margin-bottom: 0; }
  #faq-{{ section.id }} .faq-site__answer a { color: inherit; text-decoration: underline; }

  @media screen and (max-width: 749px) {
    #faq-{{ section.id }} {
      padding: var(--faq-pad-top-m) var(--faq-pad-x-m) var(--faq-pad-bottom-m);
    }
    #faq-{{ section.id }} .faq-site__title {
      font-size: var(--faq-title-size-m);
      margin-bottom: {{ section.settings.title_spacing_mobile }}px;
    }
    #faq-{{ section.id }} .faq-site__groups { gap: {{ section.settings.groups_gap_mobile }}px; }
    #faq-{{ section.id }} .faq-site__category {
      font-size: var(--faq-category-size-m);
      margin-bottom: {{ section.settings.category_spacing_mobile }}px;
    }
    #faq-{{ section.id }} .faq-site__questions {
      grid-template-columns: minmax(0, 1fr);
    }
    #faq-{{ section.id }} .faq-site__question {
      font-size: var(--faq-question-size-m);
      padding-top: var(--faq-row-y-m);
      padding-bottom: var(--faq-row-y-m);
    }
    #faq-{{ section.id }} .faq-site__answer { font-size: var(--faq-answer-size-m); }
  }
  @media (prefers-reduced-motion: reduce) {
    #faq-{{ section.id }} .faq-site__chevron { transition: none; }
  }
</style>

{% if section.settings.single_open %}
  <script>
    (function() {
      var root = document.getElementById('faq-{{ section.id }}');
      if (!root || root.dataset.faqBound === '1') return;
      root.dataset.faqBound = '1';
      root.addEventListener('toggle', function(event) {
        var current = event.target;
        if (!current.matches || !current.matches('.faq-site__item') || !current.open) return;
        root.querySelectorAll('.faq-site__item[open]').forEach(function(item) {
          if (item !== current) item.open = false;
        });
      }, true);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "FAQ générale responsive",
  "tag": "section",
  "class": "section-faq-generale",
  "settings": [
    { "type": "header", "content": "Titre et rubriques" },
    { "type": "text", "id": "title", "label": "Titre principal", "default": "Questions fréquentes" },
    { "type": "text", "id": "group_livraison", "label": "Rubrique 1", "default": "Livraison et expédition" },
    { "type": "text", "id": "group_paiement", "label": "Rubrique 2", "default": "Paiement et commandes" },
    { "type": "text", "id": "group_garantie", "label": "Rubrique 3", "default": "Retours, garantie et assistance" },
    { "type": "text", "id": "group_produits", "label": "Rubrique 4", "default": "Produits et utilisation" },
    { "type": "checkbox", "id": "single_open", "label": "Fermer les autres réponses à l'ouverture", "default": false },
    { "type": "header", "content": "Dimensions et disposition" },
    { "type": "range", "id": "max_width", "label": "Largeur maximale - PC", "min": 700, "max": 1600, "step": 10, "unit": "px", "default": 1120 },
    { "type": "range", "id": "columns_gap", "label": "Espace entre colonnes - PC", "min": 8, "max": 80, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "groups_gap", "label": "Espace entre rubriques - PC", "min": 12, "max": 90, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "groups_gap_mobile", "label": "Espace entre rubriques - mobile", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "title_spacing", "label": "Espace sous titre - PC", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "title_spacing_mobile", "label": "Espace sous titre - mobile", "min": 10, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "category_spacing", "label": "Espace sous rubrique - PC", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "category_spacing_mobile", "label": "Espace sous rubrique - mobile", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "row_padding", "label": "Hauteur intérieure questions - PC", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "row_padding_mobile", "label": "Hauteur intérieure questions - mobile", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "icon_size", "label": "Taille des flèches", "min": 10, "max": 26, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Typographie" },
    { "type": "select", "id": "faq_font", "label": "Police", "options": [{ "value": "theme", "label": "Police du thème" }, { "value": "manrope", "label": "Manrope" }], "default": "theme" },
    { "type": "select", "id": "title_alignment", "label": "Alignement du titre", "options": [{ "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centré" }, { "value": "right", "label": "Droite" }], "default": "center" },
    { "type": "select", "id": "title_weight", "label": "Graisse du titre", "options": [{ "value": "500", "label": "Moyen" }, { "value": "600", "label": "Semi-gras" }, { "value": "700", "label": "Gras" }, { "value": "800", "label": "Extra-gras" }], "default": "700" },
    { "type": "range", "id": "title_size", "label": "Titre - taille PC", "min": 22, "max": 60, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "title_size_mobile", "label": "Titre - taille mobile", "min": 20, "max": 44, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "category_size", "label": "Rubriques - taille PC", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "category_size_mobile", "label": "Rubriques - taille mobile", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "question_size", "label": "Questions - taille PC", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "question_size_mobile", "label": "Questions - taille mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "answer_size", "label": "Réponses - taille PC", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "answer_size_mobile", "label": "Réponses - taille mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg_color", "label": "Fond de la section", "default": "#FFFFFF" },
    { "type": "color", "id": "title_color", "label": "Titre principal", "default": "#252525" },
    { "type": "color", "id": "category_color", "label": "Titres des rubriques", "default": "#242424" },
    { "type": "color", "id": "question_color", "label": "Texte des questions", "default": "#373737" },
    { "type": "color", "id": "answer_color", "label": "Texte des réponses", "default": "#686868" },
    { "type": "color", "id": "divider_color", "label": "Lignes séparatrices", "default": "#DEDEDE" },
    { "type": "header", "content": "Marges de section - PC" },
    { "type": "range", "id": "padding_top", "label": "Marge haute PC", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse PC", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "padding_sides", "label": "Marges latérales PC", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Marges de section - mobile" },
    { "type": "range", "id": "padding_top_mobile", "label": "Marge haute mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Marge basse mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_sides_mobile", "label": "Marges latérales mobile", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question / Réponse",
      "settings": [
        { "type": "select", "id": "category", "label": "Rubrique", "options": [
          { "value": "livraison", "label": "Livraison et expédition" },
          { "value": "paiement", "label": "Paiement et commandes" },
          { "value": "garantie", "label": "Retours, garantie et SAV" },
          { "value": "produits", "label": "Produits et utilisation" }
        ], "default": "livraison" },
        { "type": "text", "id": "question", "label": "Question", "default": "Comment fonctionne la livraison ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Retrouvez toutes les informations relatives à votre commande dans les conditions de livraison de notre boutique.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ générale responsive",
      "blocks": [
        { "type": "question", "settings": { "category": "livraison", "question": "Où livrez-vous vos produits ?", "answer": "<p>Les zones de livraison disponibles sont indiquées au moment de la validation de votre commande. Les frais éventuels sont calculés selon votre destination.</p>" } },
        { "type": "question", "settings": { "category": "livraison", "question": "Quels sont les délais de livraison ?", "answer": "<p>Les délais estimés dépendent du produit, de son stock et de votre adresse. L'estimation applicable est indiquée lors de votre commande.</p>" } },
        { "type": "question", "settings": { "category": "livraison", "question": "Comment suivre ma commande ?", "answer": "<p>Lorsqu'un suivi est disponible, vous recevez les informations d'expédition par e-mail. Vous pouvez également contacter notre service client avec votre numéro de commande.</p>" } },
        { "type": "question", "settings": { "category": "livraison", "question": "Comment mon produit est-il emballé ?", "answer": "<p>Votre produit est préparé dans un emballage adapté à son transport. Vérifiez l'état du colis lors de la réception et signalez rapidement tout dommage.</p>" } },
        { "type": "question", "settings": { "category": "paiement", "question": "Quels moyens de paiement acceptez-vous ?", "answer": "<p>Les moyens de paiement disponibles sont affichés lors du passage en caisse, avant la validation définitive de la commande.</p>" } },
        { "type": "question", "settings": { "category": "paiement", "question": "Le paiement sur votre site est-il sécurisé ?", "answer": "<p>Le paiement est traité par les prestataires proposés à la caisse. Vérifiez les moyens de paiement et les informations affichées avant de confirmer votre achat.</p>" } },
        { "type": "question", "settings": { "category": "paiement", "question": "Puis-je modifier ou annuler ma commande ?", "answer": "<p>Contactez notre service client au plus vite avec votre numéro de commande. Les possibilités de modification ou d'annulation dépendent de l'état de préparation et d'expédition.</p>" } },
        { "type": "question", "settings": { "category": "paiement", "question": "Comment obtenir une facture ?", "answer": "<p>Pour toute demande de facture, contactez notre service client en indiquant votre numéro de commande et les informations de facturation nécessaires.</p>" } },
        { "type": "question", "settings": { "category": "garantie", "question": "Que faire si mon produit arrive endommagé ?", "answer": "<p>Contactez notre service client dès que possible, avec votre numéro de commande et des photos du colis et du produit. Nous vous indiquerons la marche à suivre.</p>" } },
        { "type": "question", "settings": { "category": "garantie", "question": "Quelle garantie s'applique à mon produit ?", "answer": "<p>Les garanties légales applicables restent en vigueur. Les éventuelles garanties commerciales et leurs conditions sont précisées sur la fiche produit ou dans nos conditions de garantie.</p>" } },
        { "type": "question", "settings": { "category": "garantie", "question": "Comment contacter le service après-vente ?", "answer": "<p>Utilisez la page de contact de notre boutique en précisant votre numéro de commande, le modèle concerné et une description de votre demande.</p>" } },
        { "type": "question", "settings": { "category": "garantie", "question": "Puis-je retourner un article ?", "answer": "<p>Consultez notre politique de retour pour connaître les conditions et la procédure applicables, ainsi que vos droits légaux éventuels. Contactez-nous avant tout renvoi.</p>" } },
        { "type": "question", "settings": { "category": "produits", "question": "Comment choisir le modèle adapté à mes besoins ?", "answer": "<p>Comparez notamment l'autonomie annoncée, la puissance, le poids, le confort et les dimensions indiqués sur chaque fiche produit.</p>" } },
        { "type": "question", "settings": { "category": "produits", "question": "Quelle est l'autonomie réelle de la batterie ?", "answer": "<p>L'autonomie peut varier selon le poids transporté, la vitesse, le relief, la température, l'état de la batterie et les conditions d'utilisation.</p>" } },
        { "type": "question", "settings": { "category": "produits", "question": "Combien de temps faut-il pour recharger la batterie ?", "answer": "<p>Le temps de charge dépend du modèle, de la capacité de la batterie et du chargeur. Consultez les caractéristiques techniques et la notice du produit.</p>" } },
        { "type": "question", "settings": { "category": "produits", "question": "Comment entretenir mon produit ?", "answer": "<p>Suivez la notice du fabricant pour le nettoyage, le contrôle des pneus et des freins, le rangement ainsi que la recharge de la batterie. Respectez les consignes de sécurité avant chaque utilisation.</p>" } }
      ]
    }
  ]
}
{% endschema %}