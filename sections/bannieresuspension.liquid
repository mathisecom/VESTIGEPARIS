    },
    {
      "type": "range",
      "id": "inner_side_mobile",
      "label": "Espaces intérieurs côtés mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Bannière suspension"
    }
  ]
}
{% endschema %}