{% comment %}
  SECTION : Bannière immersive - Suspension
  Installation : Boutique en ligne > Thèmes > Modifier le code > sections
  Nom de fichier : banniere-suspension-responsive.liquid
  Toutes les options sont configurables dans l'éditeur de thème Shopify.
{% endcomment %}

<section class="susp-hero susp-hero--{{ section.id }}" aria-label="Présentation des caractéristiques du produit">
  <div class="susp-hero__container">
    <div class="susp-hero__visual">
      {% liquid
        assign image_principale = section.settings.image_pc
        if image_principale == blank
          assign image_principale = section.settings.image_mobile
        endif
      %}

      {% if image_principale != blank %}
        <picture class="susp-hero__picture" aria-hidden="true">
          {% if section.settings.image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 480 }} 480w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
              sizes="100vw"
            >
          {% endif %}
          <img
            class="susp-hero__image"
            src="{{ image_principale | image_url: width: 2200 }}"
            srcset="{{ image_principale | image_url: width: 800 }} 800w, {{ image_principale | image_url: width: 1200 }} 1200w, {{ image_principale | image_url: width: 1600 }} 1600w, {{ image_principale | image_url: width: 2200 }} 2200w"
            sizes="100vw"
            width="{{ image_principale.width }}"
            height="{{ image_principale.height }}"
            alt=""
            loading="lazy"
          >
        </picture>
      {% endif %}

      <div class="susp-hero__overlay" aria-hidden="true"></div>

      <div class="susp-hero__layout">
        <div class="susp-hero__content">
          {% if section.settings.titre_pc != blank %}
            <h2 class="susp-hero__heading susp-hero__heading--pc">
              {{ section.settings.titre_pc | escape | newline_to_br }}
            </h2>
          {% endif %}

          {% if section.settings.titre_mobile != blank %}
            <h2 class="susp-hero__heading susp-hero__heading--mobile">
              {{ section.settings.titre_mobile | escape | newline_to_br }}
            </h2>
          {% elsif section.settings.titre_pc != blank %}
            <h2 class="susp-hero__heading susp-hero__heading--mobile">
              {{ section.settings.titre_pc | escape | newline_to_br }}
            </h2>
          {% endif %}

          {% if section.settings.texte_pc != blank %}
            <div class="susp-hero__description susp-hero__description--pc">
              {{ section.settings.texte_pc | escape | newline_to_br }}
            </div>
          {% endif %}

          {% if section.settings.texte_mobile != blank %}
            <div class="susp-hero__description susp-hero__description--mobile">
              {{ section.settings.texte_mobile | escape | newline_to_br }}
            </div>
          {% elsif section.settings.texte_pc != blank %}
            <div class="susp-hero__description susp-hero__description--mobile">
              {{ section.settings.texte_pc | escape | newline_to_br }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* SECTION ISOLÉE : aucun style n'affecte les autres sections */
  .susp-hero--{{ section.id }} {
    width: 100%;
    padding: {{ section.settings.outer_top_pc }}px {{ section.settings.outer_side_pc }}px {{ section.settings.outer_bottom_pc }}px;
    background: {{ section.settings.section_color }};
    font-family: inherit;
  }

  .susp-hero--{{ section.id }} *,
  .susp-hero--{{ section.id }} *::before,
  .susp-hero--{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .susp-hero--{{ section.id }} .susp-hero__container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin-inline: auto;
  }

  .susp-hero--{{ section.id }} .susp-hero__visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: {{ section.settings.height_pc }}px;
    border-radius: {{ section.settings.radius_pc }}px;
    background: linear-gradient(180deg, #120606 0%, #500000 50%, {{ section.settings.fallback_color }} 100%);
  }

  .susp-hero--{{ section.id }} .susp-hero__picture {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .susp-hero--{{ section.id }} .susp-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.position_image_pc }};
  }

  .susp-hero--{{ section.id }} .susp-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.opacity_pc | divided_by: 100.0 }};
  }

  .susp-hero--{{ section.id }} .susp-hero__layout {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    min-height: {{ section.settings.height_pc }}px;
    flex-direction: column;
    align-items: {{ section.settings.align_pc }};
    justify-content: {{ section.settings.vertical_pc }};
    padding: {{ section.settings.inner_top_pc }}px {{ section.settings.inner_side_pc }}px {{ section.settings.inner_bottom_pc }}px;
  }

  .susp-hero--{{ section.id }} .susp-hero__content {
    width: 100%;
    max-width: {{ section.settings.content_width_pc }}px;
    text-align: {{ section.settings.text_align_pc }};
  }

  .susp-hero--{{ section.id }} .susp-hero__heading {
    padding: 0;
    margin: 0 0 {{ section.settings.gap_pc }}px;
    color: {{ section.settings.heading_color }};
    font-family: inherit;
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_pc | divided_by: 100.0 }};
    letter-spacing: -0.035em;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .susp-hero--{{ section.id }} .susp-hero__description {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-family: inherit;
    font-size: {{ section.settings.text_size_pc }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: {{ section.settings.text_line_pc | divided_by: 100.0 }};
    overflow-wrap: anywhere;
  }

  .susp-hero--{{ section.id }} .susp-hero__heading--mobile,
  .susp-hero--{{ section.id }} .susp-hero__description--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .susp-hero--{{ section.id }} {
      padding: {{ section.settings.outer_top_mobile }}px {{ section.settings.outer_side_mobile }}px {{ section.settings.outer_bottom_mobile }}px;
    }

    .susp-hero--{{ section.id }} .susp-hero__visual {
      min-height: {{ section.settings.height_mobile }}px;
      border-radius: {{ section.settings.radius_mobile }}px;
    }

    .susp-hero--{{ section.id }} .susp-hero__image {
      object-position: {{ section.settings.position_image_mobile }};
    }

    .susp-hero--{{ section.id }} .susp-hero__overlay {
      opacity: {{ section.settings.opacity_mobile | divided_by: 100.0 }};
    }

    .susp-hero--{{ section.id }} .susp-hero__layout {
      min-height: {{ section.settings.height_mobile }}px;
      align-items: {{ section.settings.align_mobile }};
      justify-content: {{ section.settings.vertical_mobile }};
      padding: {{ section.settings.inner_top_mobile }}px {{ section.settings.inner_side_mobile }}px {{ section.settings.inner_bottom_mobile }}px;
    }

    .susp-hero--{{ section.id }} .susp-hero__content {
      max-width: {{ section.settings.content_width_mobile }}px;
      text-align: {{ section.settings.text_align_mobile }};
    }

    .susp-hero--{{ section.id }} .susp-hero__heading {
      margin-bottom: {{ section.settings.gap_mobile }}px;
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: {{ section.settings.heading_line_mobile | divided_by: 100.0 }};
    }

    .susp-hero--{{ section.id }} .susp-hero__description {
      font-size: {{ section.settings.text_size_mobile }}px;
      line-height: {{ section.settings.text_line_mobile | divided_by: 100.0 }};
    }

    .susp-hero--{{ section.id }} .susp-hero__heading--pc,
    .susp-hero--{{ section.id }} .susp-hero__description--pc {
      display: none;
    }

    .susp-hero--{{ section.id }} .susp-hero__heading--mobile,
    .susp-hero--{{ section.id }} .susp-hero__description--mobile {
      display: block;
    }
  }
</style>

{% schema %}
{
  "name": "Bannière suspension",
  "tag": "section",
  "class": "section-banniere-suspension",
  "settings": [
    {
      "type": "header",
      "content": "Images de fond"
    },
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Image de fond - ordinateur"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image de fond - mobile",
      "info": "Facultatif : sans image mobile, l'image PC est utilisée. Prévoir une image verticale sans texte incrusté."
    },
    {
      "type": "select",
      "id": "position_image_pc",
      "label": "Cadrage image PC",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"}
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "position_image_mobile",
      "label": "Cadrage image mobile",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"}
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fond de secours (sans image)",
      "default": "#B50000"
    },
    {
      "type": "header",
      "content": "Titres et descriptions"
    },
    {
      "type": "textarea",
      "id": "titre_pc",
      "label": "Titre PC",
      "default": "Suspension avant\net arrière"
    },
    {
      "type": "textarea",
      "id": "titre_mobile",
      "label": "Titre mobile (facultatif)",
      "default": "Suspension avant et arrière"
    },
    {
      "type": "textarea",
      "id": "texte_pc",
      "label": "Description PC",
      "default": "Une conduite fluide, même sur les terrains difficiles. La double suspension absorbe les chocs pour un confort optimal."
    },
    {
      "type": "textarea",
      "id": "texte_mobile",
      "label": "Description mobile (facultatif)",
      "default": "Une conduite fluide, même sur les terrains difficiles. La double suspension absorbe les chocs."
    },
    {
      "type": "header",
      "content": "Couleurs et style"
    },
    {
      "type": "color",
      "id": "section_color",
      "label": "Fond autour de la bannière",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Couleur du titre",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur de la description",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Couleur du voile sur l'image",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "opacity_pc",
      "label": "Opacité du voile PC",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 5
    },
    {
      "type": "range",
      "id": "opacity_mobile",
      "label": "Opacité du voile mobile",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 10
    },
    {
      "type": "header",
      "content": "Dimensions PC"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale de la bannière",
      "min": 900,
      "max": 2200,
      "step": 20,
      "unit": "px",
      "default": 1900
    },
    {
      "type": "range",
      "id": "height_pc",
      "label": "Hauteur de la bannière PC",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 710
    },
    {
      "type": "range",
      "id": "radius_pc",
      "label": "Arrondi des coins PC",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_width_pc",
      "label": "Largeur du texte PC",
      "min": 250,
      "max": 850,
      "step": 10,
      "unit": "px",
      "default": 620
    },
    {
      "type": "select",
      "id": "align_pc",
      "label": "Position horizontale PC",
      "options": [
        {"value": "flex-start", "label": "Gauche"},
        {"value": "center", "label": "Centre"},
        {"value": "flex-end", "label": "Droite"}
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "vertical_pc",
      "label": "Position verticale PC",
      "options": [
        {"value": "flex-start", "label": "Haut"},
        {"value": "center", "label": "Centre"},
        {"value": "flex-end", "label": "Bas"}
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_align_pc",
      "label": "Alignement du texte PC",
      "options": [
        {"value": "left", "label": "Gauche"},
        {"value": "center", "label": "Centré"},
        {"value": "right", "label": "Droite"}
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typographie PC"
    },
    {
      "type": "range",
      "id": "heading_size_pc",
      "label": "Taille du titre PC",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "text_size_pc",
      "label": "Taille description PC",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "heading_line_pc",
      "label": "Interligne titre PC",
      "min": 90,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 105
    },
    {
      "type": "range",
      "id": "text_line_pc",
      "label": "Interligne description PC",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 150
    },
    {
      "type": "range",
      "id": "gap_pc",
      "label": "Espace titre / description PC",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Graisse du titre",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi-gras"},
        {"value": "700", "label": "Gras"},
        {"value": "800", "label": "Extra-gras"}
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Graisse de la description",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi-gras"}
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Espacements PC"
    },
    {
      "type": "range",
      "id": "outer_top_pc",
      "label": "Marge section haut PC",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "outer_bottom_pc",
      "label": "Marge section bas PC",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "outer_side_pc",
      "label": "Marges extérieures côtés PC",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "inner_top_pc",
      "label": "Espace intérieur haut PC",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "inner_bottom_pc",
      "label": "Espace intérieur bas PC",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "inner_side_pc",
      "label": "Espaces intérieurs côtés PC",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "header",
      "content": "Dimensions et position mobile"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Hauteur de la bannière mobile",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
