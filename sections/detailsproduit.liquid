{% comment %}
  Section Shopify : Détails du produit + contenu du colis
  Fichier : sections/details-produit-accordeon.liquid
  Toutes les données exemples peuvent être modifiées dans l'éditeur de thème.
{% endcomment %}

<section
  id="details-produit-{{ section.id }}"
  class="dp-section"
  data-dp-section
  style="
    --dp-text: {{ section.settings.text_color }};
    --dp-muted: {{ section.settings.muted_color }};
    --dp-line: {{ section.settings.line_color }};
    --dp-panel: {{ section.settings.panel_color }};
    --dp-icon-bg: {{ section.settings.icon_background }};
    --dp-accent: {{ section.settings.accent_color }};
    --dp-tab: {{ section.settings.tab_color }};
    --dp-width: {{ section.settings.max_width }}px;
    --dp-box-width: {{ section.settings.box_width }}px;
    --dp-cols-gap: {{ section.settings.columns_gap }}px;
    --dp-radius: {{ section.settings.box_radius }}px;
    --dp-title-pc: {{ section.settings.title_size_desktop }}px;
    --dp-title-mobile: {{ section.settings.title_size_mobile }}px;
    --dp-label-pc: {{ section.settings.group_size_desktop }}px;
    --dp-label-mobile: {{ section.settings.group_size_mobile }}px;
    --dp-item-pc: {{ section.settings.item_size_desktop }}px;
    --dp-item-mobile: {{ section.settings.item_size_mobile }}px;
    --dp-value-pc: {{ section.settings.value_size_desktop }}px;
    --dp-value-mobile: {{ section.settings.value_size_mobile }}px;
    --dp-box-title-pc: {{ section.settings.box_title_size_desktop }}px;
    --dp-box-title-mobile: {{ section.settings.box_title_size_mobile }}px;
    --dp-icon-pc: {{ section.settings.icon_size_desktop }}px;
    --dp-icon-mobile: {{ section.settings.icon_size_mobile }}px;
    --dp-top-pc: {{ section.settings.padding_top_desktop }}px;
    --dp-bottom-pc: {{ section.settings.padding_bottom_desktop }}px;
    --dp-side-pc: {{ section.settings.padding_side_desktop }}px;
    --dp-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --dp-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --dp-side-mobile: {{ section.settings.padding_side_mobile }}px;
  "
>
  <div class="dp-inner">
    {% if section.settings.heading != blank %}
      <h2 class="dp-heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="dp-layout">
      <div class="dp-accordions">
        {% for group in (1..2) %}
          {% assign group_key = 'technical' %}
          {% assign group_title = section.settings.technical_title %}
          {% assign default_open = section.settings.technical_open_desktop %}
          {% if group == 2 %}
            {% assign group_key = 'performance' %}
            {% assign group_title = section.settings.performance_title %}
            {% assign default_open = section.settings.performance_open_desktop %}
          {% endif %}

          <details
            class="dp-accordion"
            data-open-desktop="{{ default_open }}"
            data-open-mobile="{{ section.settings.accordions_open_mobile }}"
          >
            <summary class="dp-accordion-title">
              <span>{{ group_title | escape }}</span>
              <span class="dp-toggle" aria-hidden="true"></span>
            </summary>
            <div class="dp-accordion-content">
              <div class="dp-specs">
                {% assign spec_count = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'spec' and block.settings.group == group_key %}
                    {% assign spec_count = spec_count | plus: 1 %}
                    <div class="dp-spec" {{ block.shopify_attributes }}>
                      <div class="dp-spec-name">{{ block.settings.label | escape }}</div>
                      <div class="dp-spec-value">{{ block.settings.value | escape | newline_to_br }}</div>
                    </div>
                  {% endif %}
                {% endfor %}
                {% if spec_count == 0 %}
                  <p class="dp-empty">Ajoutez des caractéristiques dans l’éditeur de thème.</p>
                {% endif %}
              </div>
            </div>
          </details>
        {% endfor %}
      </div>

      <div class="dp-pack-wrap">
        {% if section.settings.show_tab %}
          <div class="dp-pack-tab" aria-hidden="true">
            <span class="dp-pack-slot"></span>
          </div>
        {% endif %}
        <div class="dp-pack-card{% unless section.settings.show_tab %} dp-pack-card--no-tab{% endunless %}">
          {% if section.settings.box_title != blank %}
            <h3 class="dp-pack-title">{{ section.settings.box_title | escape }}</h3>
          {% endif %}
          <div class="dp-pack-items">
            {% for block in section.blocks %}
              {% if block.type == 'pack_item' %}
                <div class="dp-pack-item" {{ block.shopify_attributes }}>
                  <div class="dp-pack-icon" aria-hidden="true">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'dp-pack-image', alt: '' }}
                    {% else %}
                      {% case block.settings.icon %}
                        {% when 'vehicle' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="36" r="7"/><circle cx="37" cy="36" r="7"/><path d="M12 36h12l5-13h8l-3 13M16 20h8l5 7M23 20l3-7h6M8 28l7-9 5-1M30 13h6"/><path d="M18 11h8"/></svg>
                        {% when 'toolbox' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="17" width="38" height="25" rx="3"/><path d="M17 17v-6a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v6M5 27h38M21 24v7h6v-7"/></svg>
                        {% when 'charger' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7v12M31 7v12M12 19h23v7c0 8-5 12-11.5 12S12 34 12 26v-7ZM24 38v5h13"/><path d="M20 26h7"/></svg>
                        {% when 'manual' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 5h24v33H7zM31 12h10v31H16v-5M13 14h12M13 21h12M13 28h8M35 20h3M35 27h3"/></svg>
                        {% when 'key' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="15" cy="32" r="9"/><path d="m21 26 18-18 4 4-5 5 2 3-5 5-3-2-6 6"/></svg>
                        {% when 'helmet' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 27a18 18 0 0 1 36 0v6H25l-4 7H9V27Z"/><path d="M6 29h15M29 33v-8"/></svg>
                        {% when 'lock' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="21" width="30" height="23" rx="3"/><path d="M15 21v-8a9 9 0 0 1 18 0v8"/><circle cx="24" cy="31" r="2"/><path d="M24 33v5"/></svg>
                        {% when 'battery' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="35" height="27" rx="3"/><path d="M40 20h4v9h-4M23 17l-7 10h7l-4 7"/></svg>
                        {% when 'gift' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="20" width="36" height="23" rx="2"/><path d="M4 14h40v8H4zM24 14v29M24 14c-12 0-16-3-13-9s12 2 13 9Zm0 0c12 0 16-3 13-9s-12 2-13 9Z"/></svg>
                        {% when 'wrench' %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M39 7a12 12 0 0 0-14 15L8 39a5 5 0 0 0 7 7l17-17A12 12 0 0 0 46 15l-8 8-9-3-2-9Z"/></svg>
                        {% else %}
                          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="18"/><path d="M24 15v18M15 24h18"/></svg>
                      {% endcase %}
                    {% endif %}
                  </div>
                  <div class="dp-pack-item-title">{{ block.settings.title | escape }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #details-produit-{{ section.id }} {
    color: var(--dp-text);
    padding: var(--dp-top-pc) var(--dp-side-pc) var(--dp-bottom-pc);
    font-family: inherit;
    width: 100%;
  }
  #details-produit-{{ section.id }} *,
  #details-produit-{{ section.id }} *::before,
  #details-produit-{{ section.id }} *::after { box-sizing: border-box; }
  #details-produit-{{ section.id }} .dp-inner {
    max-width: var(--dp-width); width: 100%; margin: 0 auto;
  }
  #details-produit-{{ section.id }} .dp-heading {
    font-family: inherit; font-size: var(--dp-title-pc); font-weight: 600;
    line-height: 1.1; letter-spacing: -0.045em; color: var(--dp-text);
    margin: 0 0 46px;
  }
  #details-produit-{{ section.id }} .dp-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--dp-box-width));
    align-items: start; gap: var(--dp-cols-gap);
  }
  #details-produit-{{ section.id }} .dp-accordions { min-width: 0; }
  #details-produit-{{ section.id }} .dp-accordion {
    border: 0; border-bottom: 1px solid var(--dp-line);
  }
  #details-produit-{{ section.id }} .dp-accordion-title {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; cursor: pointer; list-style: none; user-select: none;
    padding: 20px 0; color: var(--dp-text);
    font-size: var(--dp-label-pc); font-weight: 500; line-height: 1.35;
  }
  #details-produit-{{ section.id }} .dp-accordion:first-child .dp-accordion-title { padding-top: 0; }
  #details-produit-{{ section.id }} .dp-accordion-title::-webkit-details-marker { display: none; }
  #details-produit-{{ section.id }} .dp-accordion-title::marker { content: ''; }
  #details-produit-{{ section.id }} .dp-accordion-title:focus-visible {
    outline: 2px solid var(--dp-accent); outline-offset: 4px;
  }
  #details-produit-{{ section.id }} .dp-toggle {
    font-size: 22px; line-height: 1; font-weight: 300; flex: none;
  }
  #details-produit-{{ section.id }} .dp-toggle::before { content: '+'; }
  #details-produit-{{ section.id }} details[open] .dp-toggle::before { content: '×'; }
  #details-produit-{{ section.id }} .dp-accordion-content { padding: 10px 0 28px; }
  #details-produit-{{ section.id }} .dp-specs {
    columns: 2; column-gap: clamp(24px, 5vw, 82px);
  }
  #details-produit-{{ section.id }} .dp-spec {
    break-inside: avoid; page-break-inside: avoid; display: block;
    margin: 0 0 28px;
  }
  #details-produit-{{ section.id }} .dp-spec-name {
    font-size: var(--dp-item-pc); font-weight: 600; color: var(--dp-text);
    line-height: 1.35; margin-bottom: 7px;
  }
  #details-produit-{{ section.id }} .dp-spec-value {
    font-size: var(--dp-value-pc); font-weight: 400; color: var(--dp-muted);
    line-height: 1.45;
  }
  #details-produit-{{ section.id }} .dp-empty {
    font-size: var(--dp-value-pc); color: var(--dp-muted); margin: 0;
  }
  #details-produit-{{ section.id }} .dp-pack-wrap {
    position: relative; width: 100%; min-width: 0; padding-top: 55px; margin-top: -55px;
  }
  #details-produit-{{ section.id }} .dp-pack-tab {
    position: absolute; width: 185px; height: 87px;
    left: 50%; transform: translateX(-50%); top: 0;
    background: var(--dp-tab); border-radius: 18px 18px 0 0;
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 34px;
  }
  #details-produit-{{ section.id }} .dp-pack-slot {
    width: 92px; height: 12px; border-radius: 999px;
    background: #fff; display: block; position: relative;
  }
  #details-produit-{{ section.id }} .dp-pack-slot::before {
    content: ''; position: absolute; width: 20px; height: 20px;
    border-radius: 50%; background: #fff; top: -9px; left: 50%;
    transform: translateX(-50%);
  }
  #details-produit-{{ section.id }} .dp-pack-card {
    position: relative; z-index: 1; background: var(--dp-panel);
    border-radius: var(--dp-radius); text-align: center;
    padding: 29px 21px 30px;
  }
  #details-produit-{{ section.id }} .dp-pack-card--no-tab { margin-top: -55px; }
  #details-produit-{{ section.id }} .dp-pack-title {
    font-family: inherit; color: var(--dp-text);
    font-weight: 600; letter-spacing: -0.035em;
    font-size: var(--dp-box-title-pc); line-height: 1.25;
    margin: 0 0 27px;
  }
  #details-produit-{{ section.id }} .dp-pack-items {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 23px 8px;
  }
  #details-produit-{{ section.id }} .dp-pack-item {
    display: flex; flex: 0 1 calc((100% - 16px)/3); min-width: 0;
    flex-direction: column; align-items: center; gap: 10px;
  }
  #details-produit-{{ section.id }} .dp-pack-icon {
    width: var(--dp-icon-pc); height: var(--dp-icon-pc);
    background: var(--dp-icon-bg); border-radius: 50%;
    display: flex; justify-content: center; align-items: center;
    color: var(--dp-accent); flex: 0 0 auto;
  }
  #details-produit-{{ section.id }} .dp-pack-icon svg {
    display: block; width: 48%; height: 48%;
  }
  #details-produit-{{ section.id }} .dp-pack-image {
    display: block; width: 70%; height: 70%; object-fit: contain;
  }
  #details-produit-{{ section.id }} .dp-pack-item-title {
    font-size: var(--dp-value-pc); line-height: 1.35;
    color: var(--dp-text); overflow-wrap: anywhere;
  }
  @media screen and (max-width: 989px) {
    #details-produit-{{ section.id }} .dp-layout {
      grid-template-columns: minmax(0, 1fr); gap: 68px;
    }
    #details-produit-{{ section.id }} .dp-pack-wrap {
      max-width: var(--dp-box-width); margin: 0 auto;
    }
  }
  @media screen and (max-width: 749px) {
    #details-produit-{{ section.id }} {
      padding: var(--dp-top-mobile) var(--dp-side-mobile) var(--dp-bottom-mobile);
    }
    #details-produit-{{ section.id }} .dp-heading {
      font-size: var(--dp-title-mobile); margin-bottom: 38px;
    }
    #details-produit-{{ section.id }} .dp-accordion-title {
      font-size: var(--dp-label-mobile); padding: 23px 0;
    }
    #details-produit-{{ section.id }} .dp-accordion:first-child .dp-accordion-title {
      padding-top: 0;
    }
    #details-produit-{{ section.id }} .dp-accordion-content {
      padding: 8px 0 12px;
    }
    #details-produit-{{ section.id }} .dp-specs { columns: 1; }
    #details-produit-{{ section.id }} .dp-spec { margin-bottom: 21px; }
    #details-produit-{{ section.id }} .dp-spec-name {
      font-size: var(--dp-item-mobile); margin-bottom: 4px;
    }
    #details-produit-{{ section.id }} .dp-spec-value,
    #details-produit-{{ section.id }} .dp-empty {
      font-size: var(--dp-value-mobile);
    }
    #details-produit-{{ section.id }} .dp-layout { gap: 79px; }
    #details-produit-{{ section.id }} .dp-pack-tab {
      width: 185px; height: 86px;
    }
    #details-produit-{{ section.id }} .dp-pack-card {
      padding: 26px 12px 32px;
    }
    #details-produit-{{ section.id }} .dp-pack-title {
      font-size: var(--dp-box-title-mobile); margin-bottom: 28px;
    }
    #details-produit-{{ section.id }} .dp-pack-items {
      gap: 26px 5px;
    }
    #details-produit-{{ section.id }} .dp-pack-item {
      flex-basis: calc((100% - 10px)/3); gap: 9px;
    }
    #details-produit-{{ section.id }} .dp-pack-icon {
      width: min(var(--dp-icon-mobile), 100%);
      height: auto; aspect-ratio: 1;
    }
    #details-produit-{{ section.id }} .dp-pack-item-title {
      font-size: var(--dp-value-mobile);
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('details-produit-{{ section.id }}');
    if (!root || root.dataset.dpReady === 'true') return;
    root.dataset.dpReady = 'true';

    const media = window.matchMedia('(min-width: 750px)');
    const details = root.querySelectorAll('.dp-accordion');
    const setInitialStates = () => {
      details.forEach(el => {
        el.open = (media.matches ? el.dataset.openDesktop : el.dataset.openMobile) === 'true';
      });
    };
    setInitialStates();
    if (media.addEventListener) media.addEventListener('change', setInitialStates);
    else media.addListener(setInitialStates);
  })();
</script>

{% schema %}
{
  "name": "Détails produit + colis",
  "tag": "section",
  "class": "section-details-produit",
  "settings": [
    { "type": "header", "content": "Textes principaux" },
    { "type": "text", "id": "heading", "label": "Titre de la section", "default": "Détails du produit" },
    { "type": "text", "id": "technical_title", "label": "Titre du premier accordéon", "default": "Caractéristiques techniques" },
    { "type": "text", "id": "performance_title", "label": "Titre du deuxième accordéon", "default": "Performances" },
    { "type": "text", "id": "box_title", "label": "Titre du contenu du colis", "default": "Contenu du colis" },
    { "type": "header", "content": "Ouverture des accordéons" },
    { "type": "checkbox", "id": "technical_open_desktop", "label": "Techniques ouvertes sur PC", "default": true },
    { "type": "checkbox", "id": "performance_open_desktop", "label": "Performances ouvertes sur PC", "default": false },
    { "type": "checkbox", "id": "accordions_open_mobile", "label": "Accordéons ouverts sur mobile", "default": false },
    { "type": "header", "content": "Dimensions et disposition" },
    { "type": "range", "id": "max_width", "label": "Largeur max de la section", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "box_width", "label": "Largeur du bloc colis", "min": 280, "max": 550, "step": 5, "unit": "px", "default": 395 },
    { "type": "range", "id": "columns_gap", "label": "Écart entre les colonnes sur PC", "min": 20, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "box_radius", "label": "Arrondi du bloc colis", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 18 },
    { "type": "checkbox", "id": "show_tab", "label": "Afficher la languette noire du colis", "default": true },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "text_color", "label": "Texte principal", "default": "#171717" },
    { "type": "color", "id": "muted_color", "label": "Texte secondaire", "default": "#888888" },
    { "type": "color", "id": "line_color", "label": "Lignes des accordéons", "default": "#E8E8E8" },
    { "type": "color", "id": "panel_color", "label": "Fond du bloc colis", "default": "#F8F8F8" },
    { "type": "color", "id": "icon_background", "label": "Fond des icônes", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Couleur des icônes", "default": "#FF792F" },
    { "type": "color", "id": "tab_color", "label": "Couleur de la languette", "default": "#171717" },
    { "type": "header", "content": "Tailles de texte - ordinateur" },
    { "type": "range", "id": "title_size_desktop", "label": "Titre principal PC", "min": 22, "max": 70, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "group_size_desktop", "label": "Titres accordéons PC", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "item_size_desktop", "label": "Noms des caractéristiques PC", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "value_size_desktop", "label": "Valeurs et légendes PC", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "box_title_size_desktop", "label": "Titre du colis PC", "min": 16, "max": 38, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_size_desktop", "label": "Diamètre des icônes PC", "min": 50, "max": 110, "step": 2, "unit": "px", "default": 80 },
    { "type": "header", "content": "Tailles de texte - mobile" },
    { "type": "range", "id": "title_size_mobile", "label": "Titre principal mobile", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "group_size_mobile", "label": "Titres accordéons mobile", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "item_size_mobile", "label": "Noms des caractéristiques mobile", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "value_size_mobile", "label": "Valeurs et légendes mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "box_title_size_mobile", "label": "Titre du colis mobile", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_size_mobile", "label": "Diamètre des icônes mobile", "min": 54, "max": 120, "step": 2, "unit": "px", "default": 92 },
    { "type": "header", "content": "Espacements - ordinateur" },
    { "type": "range", "id": "padding_top_desktop", "label": "Marge haute PC", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Marge basse PC", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 70 },
    { "type": "range", "id": "padding_side_desktop", "label": "Marges latérales PC", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 30 },
    { "type": "header", "content": "Espacements - mobile" },
