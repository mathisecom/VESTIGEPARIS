{% comment %}
  E-RYD | À propos — section Shopify personnalisable
  Installation : Boutique en ligne > Thèmes > Modifier le code > sections
  Ajoutez un fichier eryd-a-propos-personnalisable.liquid et collez ce contenu.
  Puis : Personnaliser > Ajouter une section > E-RYD - À propos.
{% endcomment %}

{% liquid
  assign hero_desktop = section.settings.hero_image
  if hero_desktop == blank
    assign hero_desktop = section.settings.hero_mobile_image
  endif
  assign hero_mobile = section.settings.hero_mobile_image
  assign hero_link = section.settings.hero_link | default: routes.all_products_collection_url
  assign bottom_link = section.settings.bottom_link | default: routes.all_products_collection_url
%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

  #eryd-about-{{ section.id }} {
    --eap-ink: {{ section.settings.color_ink }};
    --eap-accent: {{ section.settings.color_red }};
    --eap-bg: {{ section.settings.color_bg }};
    --eap-panel: {{ section.settings.color_panel }};
    --eap-muted: {{ section.settings.color_muted }};
    --eap-border: {{ section.settings.color_border }};
    --eap-radius: {{ section.settings.corner_radius }}px;
    --eap-container: {{ section.settings.container_width }}px;
    --eap-pad-top: {{ section.settings.space_top }}px;
    --eap-pad-bottom: {{ section.settings.space_bottom }}px;
    background: var(--eap-bg);
    color: var(--eap-ink);
    font-family: 'Manrope', sans-serif !important;
    overflow: clip;
    width: 100%;
    margin: 0;
  }
  #eryd-about-{{ section.id }} *,
  #eryd-about-{{ section.id }} *::before,
  #eryd-about-{{ section.id }} *::after { box-sizing: border-box; }
  #eryd-about-{{ section.id }} :is(h1,h2,h3,p,span,small,a) { font-family: 'Manrope', sans-serif !important; }
  #eryd-about-{{ section.id }} :is(h1,h2,h3,p) { margin: 0; padding: 0; }
  #eryd-about-{{ section.id }} :is(h1,h2,h3) { font-weight: 800; letter-spacing: -.045em; }
  #eryd-about-{{ section.id }} p { line-height: 1.85; }
  #eryd-about-{{ section.id }} img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #eryd-about-{{ section.id }} a { text-decoration: none; }
  #eryd-about-{{ section.id }} .eap-shell {
    width: min(var(--eap-container), calc(100% - 64px));
    margin-inline: auto;
  }
  #eryd-about-{{ section.id }} .eap-eyebrow {
    color: var(--eap-muted);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: .18em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  #eryd-about-{{ section.id }} .eap-eyebrow::before {
    content: ''; display: inline-block; width: 27px; height: 2px;
    background: var(--eap-accent); flex-shrink: 0;
  }
  #eryd-about-{{ section.id }} .eap-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 19px;
    min-height: 47px; padding: 13px 23px; border-radius: {{ section.settings.button_radius }}px;
    color: #fff !important; background: var(--eap-ink);
    border: 1px solid var(--eap-ink); font-size: 13px; font-weight: 800;
    line-height: 1.4; transition: background .2s ease, border-color .2s ease, transform .2s ease;
    text-align: center;
  }
  #eryd-about-{{ section.id }} .eap-btn:hover {
    background: var(--eap-accent); border-color: var(--eap-accent); transform: translateY(-2px);
  }
  #eryd-about-{{ section.id }} .eap-btn--white {
    background: #fff; border-color: #fff; color: #111 !important;
  }
  #eryd-about-{{ section.id }} .eap-btn--white:hover {
    background: #f0f0f0; border-color: #f0f0f0;
  }
  #eryd-about-{{ section.id }} .eap-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; }
  #eryd-about-{{ section.id }} .eap-photo { position: relative; overflow: hidden; background: #272727; }
  #eryd-about-{{ section.id }} .eap-photo picture { display: block; width: 100%; height: 100%; }
  #eryd-about-{{ section.id }} .eap-photo img { object-position: var(--eap-position-desktop, center center); }
  #eryd-about-{{ section.id }} .eap-fallback {
    position: absolute; inset: 0; display: flex; align-items: center;
    justify-content: center; flex-direction: column; gap: 10px;
    background: linear-gradient(125deg, #1b1b1b 4%, #414141 56%, #111 100%);
    color: #fff; font-weight: 800; font-size: clamp(23px, 4vw, 48px);
    letter-spacing: -.05em;
  }
  #eryd-about-{{ section.id }} .eap-fallback small { font-weight: 500; color: #c5c5c5; font-size: 12px; letter-spacing: 0; }

  /* HÉRO */
  #eryd-about-{{ section.id }} .eap-hero {
    position: relative; min-height: {{ section.settings.hero_height_pc }}px;
    isolation: isolate; display: flex; align-items: center;
    background: #181818; color: #fff;
  }
  #eryd-about-{{ section.id }} .eap-hero > .eap-photo { position: absolute; inset: 0; z-index: -2; }
  #eryd-about-{{ section.id }} .eap-hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgba(0,0,0,{{ section.settings.hero_shade | divided_by: 100.0 }}) 0%, rgba(0,0,0,.38) 51%, rgba(0,0,0,.02) 100%);
  }
  #eryd-about-{{ section.id }} .eap-hero::after {
    content: ''; position: absolute; bottom: 0; left: 0; width: 155px; height: 12px;
    background: var(--eap-accent); clip-path: polygon(0 0,94% 0,100% 100%,0 100%);
  }
  #eryd-about-{{ section.id }} .eap-hero-copy {
    padding: 80px 0; max-width: {{ section.settings.hero_text_width }}px;
    {% if section.settings.hero_align == 'center' %}margin-inline: auto; text-align: center;{% endif %}
  }
  #eryd-about-{{ section.id }} .eap-hero .eap-eyebrow { color: #eee; }
  #eryd-about-{{ section.id }} .eap-hero-copy h1 {
    color: #fff; font-size: {{ section.settings.hero_title_pc }}px;
    line-height: 1.09; margin: 22px 0 18px; max-width: 820px;
  }
  #eryd-about-{{ section.id }} .eap-hero-copy h1 strong,
  #eryd-about-{{ section.id }} .eap-hero-copy h1 em { color: var(--eap-accent); font-style: normal; }
  #eryd-about-{{ section.id }} .eap-hero-copy .eap-richtext { color: #f1f1f1; font-size: 15px; max-width: 540px; }
  #eryd-about-{{ section.id }} .eap-hero-copy .eap-btn { margin-top: 28px; }
  #eryd-about-{{ section.id }} .eap-hero--center .eap-hero-copy .eap-richtext { margin-inline: auto; }

  /* INTRO ET ARGUMENTS */
  #eryd-about-{{ section.id }} .eap-intro { padding-top: var(--eap-pad-top); text-align: center; }
  #eryd-about-{{ section.id }} .eap-intro h2 {
    font-size: {{ section.settings.heading_pc }}px; line-height: 1.23;
    max-width: 820px; margin: 20px auto 19px;
  }
  #eryd-about-{{ section.id }} .eap-intro .eap-richtext {
    max-width: 760px; margin-inline: auto; font-size: 15px; color: var(--eap-muted);
  }
  #eryd-about-{{ section.id }} .eap-richtext > * + * { margin-top: 11px; }
  #eryd-about-{{ section.id }} .eap-richtext :is(a) { color: inherit; text-decoration: underline; }
  #eryd-about-{{ section.id }} .eap-benefits {
    display: grid; grid-template-columns: repeat(3, minmax(0,1fr));
    border-top: 1px solid var(--eap-border); border-bottom: 1px solid var(--eap-border);
    text-align: left; margin-top: 55px; margin-bottom: {{ section.settings.content_gap }}px;
  }
  #eryd-about-{{ section.id }} .eap-benefit { padding: 31px; min-width: 0; }
  #eryd-about-{{ section.id }} .eap-benefit:not(:first-child) { border-left: 1px solid var(--eap-border); }
  #eryd-about-{{ section.id }} .eap-icon {
    display: inline-grid; place-items: center; flex-shrink: 0;
    width: 46px; height: 46px; border-radius: 50%; background: var(--eap-panel);
    color: var(--eap-accent); margin-bottom: 18px;
  }
  #eryd-about-{{ section.id }} .eap-icon--black { color: var(--eap-ink); }
  #eryd-about-{{ section.id }} .eap-icon svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  #eryd-about-{{ section.id }} .eap-benefit h3 { font-size: 17px; margin-bottom: 8px; line-height: 1.4; }
  #eryd-about-{{ section.id }} .eap-benefit p { font-size: 13px; color: var(--eap-muted); line-height: 1.9; }

  /* BLOCS MODULAIRES */
  #eryd-about-{{ section.id }} .eap-content { padding-bottom: var(--eap-pad-bottom); }
  #eryd-about-{{ section.id }} .eap-editorial {
    display: grid; grid-template-columns: 1.05fr .95fr; min-height: 450px;
    border-radius: var(--eap-radius); overflow: hidden;
    background: var(--eap-panel); margin-bottom: {{ section.settings.content_gap }}px;
  }
  #eryd-about-{{ section.id }} .eap-editorial--reverse { grid-template-columns: .95fr 1.05fr; }
  #eryd-about-{{ section.id }} .eap-editorial--reverse .eap-editorial-image { order: 2; }
  #eryd-about-{{ section.id }} .eap-editorial-image { min-height: 410px; position: relative; }
  #eryd-about-{{ section.id }} .eap-editorial-image::after { content: ''; position: absolute; top: 0; left: 0; background: var(--eap-accent); width: 133px; height: 11px; clip-path: polygon(0 0,95% 0,100% 100%,0 100%); pointer-events: none; }
  #eryd-about-{{ section.id }} .eap-editorial-copy { padding: 50px clamp(27px,4.7vw,76px); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  #eryd-about-{{ section.id }} .eap-editorial-copy h2 { margin: 18px 0; font-size: {{ section.settings.heading_pc }}px; line-height: 1.19; }
  #eryd-about-{{ section.id }} .eap-editorial-copy .eap-richtext { font-size: 14px; color: var(--eap-muted); }
  #eryd-about-{{ section.id }} .eap-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 24px; }
  #eryd-about-{{ section.id }} .eap-tag { border: 1px solid var(--eap-border); background: var(--eap-bg); border-radius: 30px; padding: 7px 12px; color: var(--eap-muted); font-size: 11px; font-weight: 700; }
  #eryd-about-{{ section.id }} .eap-editorial-copy .eap-btn { margin-top: 23px; }
  #eryd-about-{{ section.id }} .eap-tags + .eap-btn { margin-top: 0; }
  #eryd-about-{{ section.id }} .eap-banner {
    min-height: 450px; border-radius: var(--eap-radius); isolation: isolate;
    display: flex; align-items: center; position: relative; overflow: hidden;
    background: #141414; color: #fff; margin-bottom: {{ section.settings.content_gap }}px;
  }
  #eryd-about-{{ section.id }} .eap-banner > .eap-photo { position: absolute; inset: 0; z-index: -2; }
  #eryd-about-{{ section.id }} .eap-banner::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgba(0,0,0,.85), rgba(0,0,0,.53) 43%, rgba(0,0,0,.02) 100%);
  }
  #eryd-about-{{ section.id }} .eap-banner--right::before { background: linear-gradient(270deg, rgba(0,0,0,.85), rgba(0,0,0,.53) 43%, rgba(0,0,0,.02) 100%); }
  #eryd-about-{{ section.id }} .eap-banner-copy { padding: 63px 0 63px 7%; width: min(610px, 74%); }
  #eryd-about-{{ section.id }} .eap-banner--right { justify-content: flex-end; }
  #eryd-about-{{ section.id }} .eap-banner--right .eap-banner-copy { padding: 63px 7% 63px 0; }
  #eryd-about-{{ section.id }} .eap-banner .eap-eyebrow { color: #ededed; }
  #eryd-about-{{ section.id }} .eap-banner h2 { color: #fff; font-size: {{ section.settings.heading_pc }}px; line-height: 1.18; margin: 20px 0 17px; }
  #eryd-about-{{ section.id }} .eap-banner .eap-richtext { color: #ebebeb; font-size: 14px; }
  #eryd-about-{{ section.id }} .eap-banner .eap-btn { margin-top: 24px; }

  /* ACHAT RASSURANT */
  #eryd-about-{{ section.id }} .eap-reassurance { text-align: center; padding-top: 12px; padding-bottom: var(--eap-pad-bottom); }
  #eryd-about-{{ section.id }} .eap-reassurance h2 { font-size: {{ section.settings.heading_pc }}px; line-height: 1.22; margin: 19px auto; max-width: 780px; }
  #eryd-about-{{ section.id }} .eap-reassurance .eap-richtext { max-width: 690px; margin-inline: auto; color: var(--eap-muted); font-size: 14px; }
  #eryd-about-{{ section.id }} .eap-steps { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 18px; text-align: left; margin-top: 36px; }
  #eryd-about-{{ section.id }} .eap-step { padding: 28px; border: 1px solid var(--eap-border); background: var(--eap-panel); border-radius: var(--eap-radius); }
  #eryd-about-{{ section.id }} .eap-step-number { color: var(--eap-accent); font-size: 12px; font-weight: 800; letter-spacing: .13em; display: block; margin-bottom: 17px; }
  #eryd-about-{{ section.id }} .eap-step h3 { font-size: 17px; margin-bottom: 8px; }
  #eryd-about-{{ section.id }} .eap-step p { font-size: 13px; color: var(--eap-muted); line-height: 1.85; }

  /* CONCLUSION */
  #eryd-about-{{ section.id }} .eap-bottom { background: {{ section.settings.bottom_bg }}; color: #fff; position: relative; isolation: isolate; overflow: hidden; }
  #eryd-about-{{ section.id }} .eap-bottom::before { content: ''; position: absolute; z-index: -1; width: 470px; height: 470px; right: -140px; bottom: -260px; border: 78px solid {{ section.settings.color_red | color_modify: 'alpha', 0.16 }}; border-radius: 50%; }
  #eryd-about-{{ section.id }} .eap-bottom-row { display: flex; align-items: center; justify-content: space-between; gap: 45px; padding: 75px 0; }
  #eryd-about-{{ section.id }} .eap-bottom h2 { color: #fff; font-size: {{ section.settings.heading_pc }}px; line-height: 1.2; margin: 17px 0 11px; }
  #eryd-about-{{ section.id }} .eap-bottom .eap-eyebrow { color: #eee; }
  #eryd-about-{{ section.id }} .eap-bottom .eap-richtext { color: #dadada; font-size: 14px; max-width: 580px; }
  #eryd-about-{{ section.id }} .eap-bottom .eap-btn { flex-shrink: 0; }

  @media (max-width: 990px) {
    #eryd-about-{{ section.id }} .eap-editorial-copy { padding: 34px; }
    #eryd-about-{{ section.id }} .eap-editorial-image { min-height: 370px; }
    #eryd-about-{{ section.id }} .eap-benefit { padding: 24px 19px; }
    #eryd-about-{{ section.id }} .eap-steps { gap: 12px; }
    #eryd-about-{{ section.id }} .eap-step { padding: 23px; }
  }
  @media (max-width: 749px) {
    #eryd-about-{{ section.id }} { --eap-pad-top: {{ section.settings.space_top_mobile }}px; --eap-pad-bottom: {{ section.settings.space_bottom_mobile }}px; }
    #eryd-about-{{ section.id }} .eap-shell { width: calc(100% - 36px); }
    #eryd-about-{{ section.id }} .eap-photo img { object-position: var(--eap-position-mobile, var(--eap-position-desktop, center center)); }
    #eryd-about-{{ section.id }} .eap-hero { min-height: {{ section.settings.hero_height_mobile }}px; align-items: flex-end; }
    #eryd-about-{{ section.id }} .eap-hero::before { background: linear-gradient(0deg, rgba(0,0,0,{{ section.settings.hero_shade_mobile | divided_by: 100.0 }}) 0%, rgba(0,0,0,.55) 52%, rgba(0,0,0,.04) 100%); }
    #eryd-about-{{ section.id }} .eap-hero-copy { padding: 120px 0 43px; width: 100%; }
    #eryd-about-{{ section.id }} .eap-hero-copy h1 { font-size: {{ section.settings.hero_title_mobile }}px; margin: 15px 0 14px; }
    #eryd-about-{{ section.id }} .eap-hero-copy .eap-richtext { font-size: 13px; }
    #eryd-about-{{ section.id }} .eap-hero--center .eap-hero-copy { text-align: left; }
    #eryd-about-{{ section.id }} .eap-hero--center .eap-hero-copy .eap-richtext { margin-left: 0; }
    #eryd-about-{{ section.id }} .eap-intro h2,
    #eryd-about-{{ section.id }} .eap-editorial-copy h2,
    #eryd-about-{{ section.id }} .eap-banner h2,
    #eryd-about-{{ section.id }} .eap-reassurance h2,
    #eryd-about-{{ section.id }} .eap-bottom h2 { font-size: {{ section.settings.heading_mobile }}px; }
    #eryd-about-{{ section.id }} .eap-intro .eap-richtext { font-size: 13px; }
    #eryd-about-{{ section.id }} .eap-benefits { grid-template-columns: 1fr; margin-top: 37px; margin-bottom: {{ section.settings.content_gap_mobile }}px; }
    #eryd-about-{{ section.id }} .eap-benefit { padding: 20px 2px; display: grid; grid-template-columns: 46px 1fr; column-gap: 15px; }
    #eryd-about-{{ section.id }} .eap-benefit:not(:first-child) { border-left: 0; border-top: 1px solid var(--eap-border); }
    #eryd-about-{{ section.id }} .eap-benefit .eap-icon { grid-row: span 2; margin: 0; }
    #eryd-about-{{ section.id }} .eap-benefit h3 { font-size: 15px; margin-bottom: 2px; }
    #eryd-about-{{ section.id }} .eap-benefit p { font-size: 12px; }
    #eryd-about-{{ section.id }} .eap-editorial,
    #eryd-about-{{ section.id }} .eap-editorial--reverse { grid-template-columns: 1fr; margin-bottom: {{ section.settings.content_gap_mobile }}px; }
    #eryd-about-{{ section.id }} .eap-editorial .eap-editorial-image { min-height: 0; height: 265px; order: 0; }
    #eryd-about-{{ section.id }} .eap-editorial .eap-editorial-copy { order: 1; padding: 30px 23px 35px; }
    #eryd-about-{{ section.id }} .eap-editorial-copy .eap-richtext { font-size: 13px; }
    #eryd-about-{{ section.id }} .eap-banner { min-height: 435px !important; align-items: flex-end; margin-bottom: {{ section.settings.content_gap_mobile }}px; }
    #eryd-about-{{ section.id }} .eap-banner::before,
    #eryd-about-{{ section.id }} .eap-banner--right::before { background: linear-gradient(0deg, rgba(0,0,0,.9) 0%, rgba(0,0,0,.54) 46%, rgba(0,0,0,.02) 100%); }
    #eryd-about-{{ section.id }} .eap-banner .eap-banner-copy,
    #eryd-about-{{ section.id }} .eap-banner--right .eap-banner-copy { width: 100%; padding: 70px 23px 28px; }
    #eryd-about-{{ section.id }} .eap-banner .eap-richtext { font-size: 13px; }
    #eryd-about-{{ section.id }} .eap-reassurance { padding-top: 7px; }
    #eryd-about-{{ section.id }} .eap-steps { grid-template-columns: 1fr; gap: 12px; margin-top: 29px; }
    #eryd-about-{{ section.id }} .eap-step { padding: 23px; }
    #eryd-about-{{ section.id }} .eap-bottom-row { display: block; padding: 52px 0; }
    #eryd-about-{{ section.id }} .eap-bottom .eap-btn { margin-top: 23px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #eryd-about-{{ section.id }} .eap-btn { transition: none; }
    #eryd-about-{{ section.id }} .eap-btn:hover { transform: none; }
  }
</style>

<section id="eryd-about-{{ section.id }}" class="eap" aria-label="À propos d’E-RYD">
  {% if section.settings.show_hero %}
    <div class="eap-hero {% if section.settings.hero_align == 'center' %}eap-hero--center{% endif %}">
      <div class="eap-photo" style="--eap-position-desktop: {{ hero_desktop.presentation.focal_point | default: 'center center' }}; --eap-position-mobile: {{ hero_mobile.presentation.focal_point | default: 'center center' }};">
        {% if hero_desktop != blank %}
          <picture>
            {% if hero_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ hero_mobile | image_url: width: 750 }} 750w, {{ hero_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
            {% endif %}
            {{ hero_desktop | image_url: width: 2400 | image_tag: widths: '375,550,750,1100,1500,1800,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
          </picture>
        {% else %}
          <div class="eap-fallback" aria-hidden="true">E-RYD <small>Choisissez l’image principale dans Shopify</small></div>
        {% endif %}
      </div>
      <div class="eap-shell">
        <div class="eap-hero-copy">
          {% if section.settings.hero_kicker != blank %}<span class="eap-eyebrow">{{ section.settings.hero_kicker | escape }}</span>{% endif %}
          {% if section.settings.hero_title != blank or section.settings.hero_title_accent != blank %}<h1>{{ section.settings.hero_title | escape }}{% if section.settings.hero_title_accent != blank %}<br><strong>{{ section.settings.hero_title_accent | escape }}</strong>{% endif %}</h1>{% endif %}
          {% if section.settings.hero_text != blank %}<div class="eap-richtext">{{ section.settings.hero_text }}</div>{% endif %}
          {% if section.settings.hero_button != blank %}
            <a class="eap-btn eap-btn--white" href="{{ hero_link }}">{{ section.settings.hero_button | escape }}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="eap-shell">
    {% if section.settings.show_intro %}
      <div class="eap-intro">
        {% if section.settings.intro_kicker != blank %}<span class="eap-eyebrow">{{ section.settings.intro_kicker | escape }}</span>{% endif %}
        {% if section.settings.intro_title != blank %}<h2>{{ section.settings.intro_title | escape }}</h2>{% endif %}
        {% if section.settings.intro_text != blank %}<div class="eap-richtext">{{ section.settings.intro_text }}</div>{% endif %}
      </div>
    {% endif %}

    {% assign num_benefits = section.blocks | where: 'type', 'benefit' | size %}
    {% if num_benefits > 0 %}
      <div class="eap-benefits" aria-label="Les valeurs E-RYD">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="eap-benefit" {{ block.shopify_attributes }}>
              <div class="eap-icon {% if block.settings.icon_color == 'black' %}eap-icon--black{% endif %}" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'bolt' %}<svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 10-13h-7V2Z"/></svg>
                  {% when 'compass' %}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m16 8-3 5-5 3 3-5 5-3Z"/></svg>
                  {% when 'shield' %}<svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 4.7 3.2 8 8 9 4.8-1 8-4.3 8-9V7l-8-4Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
                  {% when 'battery' %}<svg viewBox="0 0 24 24"><rect x="3" y="7" width="17" height="10" rx="2"/><path d="M22 10v4M11 8l-2 4h4l-2 4"/></svg>
                  {% when 'heart' %}<svg viewBox="0 0 24 24"><path d="M20.8 9.3C20.8 14 12 21 12 21S3.2 14 3.2 9.3a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z"/></svg>
                  {% when 'truck' %}<svg viewBox="0 0 24 24"><path d="M3 6h12v11H3zM15 10h3l3 3v4h-6"/><circle cx="7.5" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                  {% when 'headset' %}<svg viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12h3v6H4a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2Zm13 0h3a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-3v-6ZM20 19c0 2-2 3-5 3h-3"/></svg>
                  {% else %}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg>
                {% endcase %}
              </div>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="eap-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'image_text' %}
            {% liquid
              assign image_main = block.settings.image
              if image_main == blank
                assign image_main = block.settings.image_mobile
              endif
              assign image_mobile = block.settings.image_mobile
            %}
            <article class="eap-editorial {% if block.settings.reverse %}eap-editorial--reverse{% endif %}" {{ block.shopify_attributes }}>
              <div class="eap-photo eap-editorial-image" style="--eap-position-desktop: {{ image_main.presentation.focal_point | default: 'center center' }}; --eap-position-mobile: {{ image_mobile.presentation.focal_point | default: image_main.presentation.focal_point | default: 'center center' }};">
                {% if image_main != blank %}
                  <picture>
                    {% if image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}
                    {{ image_main | image_url: width: 1600 | image_tag: widths: '375,550,750,990,1200,1600', sizes: '(max-width: 749px) 100vw, 55vw', loading: 'lazy' }}
                  </picture>
                {% else %}<div class="eap-fallback" aria-hidden="true">E-RYD <small>Choisissez une image pour ce bloc</small></div>{% endif %}
              </div>
              <div class="eap-editorial-copy">
                {% if block.settings.kicker != blank %}<span class="eap-eyebrow">{{ block.settings.kicker | escape }}</span>{% endif %}
                {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.body != blank %}<div class="eap-richtext">{{ block.settings.body }}</div>{% endif %}
                {% if block.settings.tags != blank %}
                  <div class="eap-tags" aria-label="Points clés">
                    {% assign chips = block.settings.tags | split: ',' %}
                    {% for chip in chips %}{% assign clean_chip = chip | strip %}{% if clean_chip != blank %}<span class="eap-tag">{{ clean_chip | escape }}</span>{% endif %}{% endfor %}
                  </div>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <a class="eap-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                  </a>
                {% endif %}
              </div>
            </article>
          {% when 'image_banner' %}
            {% liquid
              assign image_main = block.settings.image
              if image_main == blank
                assign image_main = block.settings.image_mobile
              endif
              assign image_mobile = block.settings.image_mobile
            %}
            <article class="eap-banner {% if block.settings.align == 'right' %}eap-banner--right{% endif %}" style="min-height: {{ block.settings.height }}px" {{ block.shopify_attributes }}>
              <div class="eap-photo" style="--eap-position-desktop: {{ image_main.presentation.focal_point | default: 'center center' }}; --eap-position-mobile: {{ image_mobile.presentation.focal_point | default: image_main.presentation.focal_point | default: 'center center' }};">
                {% if image_main != blank %}
                  <picture>
                    {% if image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}
                    {{ image_main | image_url: width: 2000 | image_tag: widths: '375,550,750,990,1200,1600,2000', sizes: '100vw', loading: 'lazy' }}
                  </picture>
                {% else %}<div class="eap-fallback" aria-hidden="true">E-RYD <small>Choisissez une image pour ce bandeau</small></div>{% endif %}
              </div>
              <div class="eap-banner-copy">
                {% if block.settings.kicker != blank %}<span class="eap-eyebrow">{{ block.settings.kicker | escape }}</span>{% endif %}
                {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.body != blank %}<div class="eap-richtext">{{ block.settings.body }}</div>{% endif %}
                {% if block.settings.button_label != blank %}<a class="eap-btn eap-btn--white" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>{% endif %}
              </div>
            </article>
        {% endcase %}
      {% endfor %}
    </div>

    {% if section.settings.show_reassurance %}
      <div class="eap-reassurance">
        {% if section.settings.reassurance_kicker != blank %}<span class="eap-eyebrow">{{ section.settings.reassurance_kicker | escape }}</span>{% endif %}
        {% if section.settings.reassurance_title != blank %}<h2>{{ section.settings.reassurance_title | escape }}</h2>{% endif %}
        {% if section.settings.reassurance_text != blank %}<div class="eap-richtext">{{ section.settings.reassurance_text }}</div>{% endif %}
        <div class="eap-steps">
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              <div class="eap-step" {{ block.shopify_attributes }}>
                <span class="eap-step-number">{{ block.settings.number | escape }}</span>
                <h3>{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if section.settings.show_bottom %}
    <div class="eap-bottom">
      <div class="eap-shell eap-bottom-row">
        <div>
          {% if section.settings.bottom_kicker != blank %}<span class="eap-eyebrow">{{ section.settings.bottom_kicker | escape }}</span>{% endif %}
          {% if section.settings.bottom_title != blank %}<h2>{{ section.settings.bottom_title | escape }}</h2>{% endif %}
          {% if section.settings.bottom_text != blank %}<div class="eap-richtext">{{ section.settings.bottom_text }}</div>{% endif %}
        </div>
        {% if section.settings.bottom_button != blank %}<a class="eap-btn eap-btn--white" href="{{ bottom_link }}">{{ section.settings.bottom_button | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>{% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "E-RYD - À propos",
  "tag": "section",
  "class": "eryd-about-section",
  "settings": [
    {
      "type": "header",
      "content": "Affichage général"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Afficher le bandeau principal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Afficher la présentation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reassurance",
      "label": "Afficher les étapes d’achat",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom",
      "label": "Afficher le bandeau final",
      "default": true
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Textes et boutons noirs",
      "default": "#111214"
    },
    {
      "type": "color",
      "id": "color_red",
      "label": "Rouge des icônes et accents",
      "default": "#D62E2E"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond de page",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_panel",
      "label": "Fond des cartes",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Textes secondaires",
      "default": "#666B73"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#E6E6E8"
    },
    {
      "type": "color",
      "id": "bottom_bg",
      "label": "Fond du dernier bandeau",
      "default": "#111214"
    },
    {
      "type": "header",
      "content": "Dimensions et espacements"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Largeur du contenu PC",
      "min": 900,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Arrondis des blocs",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondis des boutons",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Espace entre blocs PC",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Espace entre blocs mobile",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Marge haute introduction PC",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "label": "Marge haute introduction mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Marge basse PC",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "label": "Marge basse mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "header",
      "content": "Typographie Manrope"
    },
    {
      "type": "range",
      "id": "hero_title_pc",
      "label": "Titre bandeau PC",
      "min": 34,
      "max": 86,
      "step": 1,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "hero_title_mobile",
      "label": "Titre bandeau mobile",
      "min": 26,
      "max": 54,
      "step": 1,
      "unit": "px",
      "default": 37
    },
    {
      "type": "range",
      "id": "heading_pc",
      "label": "Titres de sections PC",
      "min": 25,
      "max": 52,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Titres de sections mobile",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 29
    },
    {
      "type": "header",
      "content": "Bandeau principal"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image PC du bandeau"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile_image",
      "label": "Image mobile (facultative)"
    },
    {
      "type": "range",
      "id": "hero_height_pc",
      "label": "Hauteur bandeau PC",
      "min": 320,
      "max": 780,
      "step": 10,
      "unit": "px",
      "default": 530
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Hauteur bandeau mobile",
      "min": 380,
      "max": 780,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "hero_text_width",
      "label": "Largeur du texte du bandeau",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 650
    },
    {
      "type": "range",
      "id": "hero_shade",
      "label": "Voile sombre PC",
      "min": 20,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "hero_shade_mobile",
      "label": "Voile sombre mobile",
      "min": 20,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "select",
      "id": "hero_align",
      "label": "Alignement du texte",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Petit texte",
      "default": "À propos d’E-RYD"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Grand titre, première ligne",
      "default": "La mobilité électrique,"
    },
    {
      "type": "text",
      "id": "hero_title_accent",
      "label": "Texte rouge, deuxième ligne",
      "default": "en toute liberté."
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Texte du bandeau",
      "default": "<p>Un univers pensé pour celles et ceux qui veulent se déplacer autrement, avec plus de simplicité et de liberté au quotidien.</p>"
    },
    {
      "type": "text",
      "id": "hero_button",
      "label": "Texte du bouton",
      "default": "Découvrir nos modèles"
    },
    {
      "type": "url",
      "id": "hero_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "intro_kicker",
      "label": "Petit texte",
      "default": "L’univers E-RYD"
    },
    {
      "type": "text",
      "id": "intro_title",
      "label": "Titre",
      "default": "Une autre façon d’imaginer vos déplacements."
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Texte de présentation",
      "default": "<p>Chez <strong>E-RYD</strong>, nous croyons à une mobilité qui s’adapte à votre rythme. Notre sélection de trottinettes électriques accompagne les nouveaux usages, les trajets quotidiens et l’envie de profiter de chaque parcours.</p>"
    },
    {
      "type": "header",
      "content": "Étapes d’achat"
    },
    {
      "type": "text",
      "id": "reassurance_kicker",
      "label": "Petit texte",
      "default": "Notre engagement"
    },
    {
      "type": "text",
      "id": "reassurance_title",
      "label": "Titre",
      "default": "Une expérience d’achat simple et rassurante."
    },
    {
      "type": "richtext",
      "id": "reassurance_text",
      "label": "Texte",
      "default": "<p>Un achat se décide plus facilement lorsqu’on dispose des bonnes informations. E-RYD souhaite rendre chaque étape claire et accessible.</p>"
    },
    {
      "type": "header",
      "content": "Bandeau final"
    },
    {
      "type": "text",
      "id": "bottom_kicker",
      "label": "Petit texte",
      "default": "E-RYD · Avancez librement"
    },
    {
      "type": "text",
      "id": "bottom_title",
      "label": "Titre",
      "default": "Prêt à changer votre manière de vous déplacer ?"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Texte",
      "default": "<p>Découvrez notre univers et trouvez la trottinette électrique qui correspond à votre quotidien.</p>"
    },
    {
      "type": "text",
      "id": "bottom_button",
      "label": "Texte du bouton",
      "default": "Voir les trottinettes"
    },
    {
      "type": "url",
      "id": "bottom_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Avantage avec icône",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "bolt",
              "label": "Éclair"
            },
            {
              "value": "compass",
              "label": "Boussole"
            },
            {
              "value": "shield",
              "label": "Bouclier"
            },
            {
              "value": "battery",
              "label": "Batterie"
            },
            {
              "value": "heart",
              "label": "Cœur"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "headset",
              "label": "Support"
            },
            {
              "value": "check",
              "label": "Validation"
            }
          ],
          "default": "bolt"
        },
        {
          "type": "select",
          "id": "icon_color",
          "label": "Couleur de l’icône",
          "options": [
            {
              "value": "red",
              "label": "Rouge"
            },
            {
              "value": "black",
              "label": "Noir"
            }
          ],
          "default": "red"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Mobilité moderne"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Des solutions électriques pensées pour votre quotidien."
        }
      ]
    },
    {
      "type": "image_text",
      "name": "Image et texte",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image PC"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile (facultative)"
        },
        {
          "type": "checkbox",
          "id": "reverse",
          "label": "Image à droite sur ordinateur",
          "default": false
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Petit texte",
          "default": "Notre spécialité"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Une sélection qui va à l’essentiel."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Texte",
          "default": "<p>La trottinette électrique est au cœur d’E-RYD. Nous mettons en avant des modèles aux usages variés, pour vous aider à faire un choix éclairé.</p><p>Autonomie, confort et praticité : découvrez les caractéristiques qui comptent.</p>"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Étiquettes (séparées par virgules)",
          "default": "Autonomie, Confort, Praticité, Design"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Bouton (vide pour masquer)",
          "default": "Explorer la sélection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien du bouton"
        }
      ]
    },
    {
      "type": "image_banner",
      "name": "Grand bandeau photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image PC"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile (facultative)"
        },
        {
          "type": "range",
          "id": "height",
          "label": "Hauteur PC",
          "min": 300,
          "max": 680,
          "step": 10,
          "unit": "px",
          "default": 450
        },
        {
          "type": "select",
          "id": "align",
          "label": "Position du texte PC",
          "options": [
            {
              "value": "left",
              "label": "Gauche"
            },
            {
              "value": "right",
              "label": "Droite"
            }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Petit texte",
          "default": "Votre quotidien, votre rythme"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Plus de liberté. Moins de contraintes."
        },
        {
          "type": "richtext",
