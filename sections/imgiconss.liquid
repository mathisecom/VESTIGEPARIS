
{% comment %}
  IMAGE + STATISTIQUES
  Typographie 100% MANROPE
  Responsive PC / Mobile
  Entièrement personnalisable
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section id="fp-story-{{ section.id }}" class="fp-story">

  <div class="fp-story__container">

    <!-- IMAGE PRINCIPALE -->
    <div class="fp-story__media">

      <div class="fp-story__image-wrapper">

        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'fp-story__image',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(max-width: 989px) 100vw, 45vw'
          }}
        {% else %}
          <div class="fp-story__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="fp-story__overlay"></div>

        <div class="fp-story__image-content">

          {% if section.settings.image_heading != blank %}
            <div class="fp-story__image-heading">
              {{ section.settings.image_heading | escape | newline_to_br }}
            </div>
          {% endif %}

          <div class="fp-story__image-bottom">

            {% if section.settings.show_stars %}
              <div class="fp-story__stars" aria-label="{{ section.settings.star_count }} étoiles sur 5">
                {% for i in (1..5) %}
                  {% if i <= section.settings.star_count %}
                    <span aria-hidden="true">★</span>
                  {% else %}
                    <span aria-hidden="true">☆</span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if section.settings.bottom_heading != blank %}
              <div class="fp-story__bottom-heading">
                {{ section.settings.bottom_heading | escape }}
              </div>
            {% endif %}

            {% if section.settings.bottom_text != blank %}
              <div class="fp-story__bottom-description">
                {{ section.settings.bottom_text | escape }}
              </div>
            {% endif %}

          </div>

        </div>

      </div>

    </div>

    <!-- CONTENU ET STATISTIQUES -->
    <div class="fp-story__content">

      {% if section.settings.main_heading != blank %}
        <h2 class="fp-story__main-heading">
          {{ section.settings.main_heading | escape | newline_to_br }}
        </h2>
      {% endif %}

      <div class="fp-story__stats">

        {% for block in section.blocks %}

          {% if block.type == 'stat' %}

            <div
              class="fp-story__stat"
              {{ block.shopify_attributes }}
            >

              <div class="fp-story__stat-number">
                {{ block.settings.number | escape }}
              </div>

              <div class="fp-story__stat-info">

                {% if block.settings.title != blank %}
                  <div class="fp-story__stat-title">
                    {{ block.settings.title | escape }}
                  </div>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="fp-story__stat-description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

</section>

<style>

/* =========================================
   CONFIGURATION GÉNÉRALE
========================================= */

#fp-story-{{ section.id }} {

  --fp-font: 'Manrope', sans-serif;

  --fp-bg: {{ section.settings.background_color }};
  --fp-title: {{ section.settings.title_color }};
  --fp-text: {{ section.settings.text_color }};
  --fp-secondary: {{ section.settings.secondary_color }};
  --fp-border: {{ section.settings.border_color }};
  --fp-card-text: {{ section.settings.card_text_color }};
  --fp-stars: {{ section.settings.stars_color }};

  width: 100%;
  background: var(--fp-bg);

  padding:
    {{ section.settings.padding_top }}px
    20px
    {{ section.settings.padding_bottom }}px;

  font-family: var(--fp-font);
  -webkit-font-smoothing: antialiased;

}

#fp-story-{{ section.id }} *,
#fp-story-{{ section.id }} *::before,
#fp-story-{{ section.id }} *::after {
  box-sizing: border-box;
}

/* =========================================
   STRUCTURE DESKTOP
========================================= */

#fp-story-{{ section.id }} .fp-story__container {

  max-width: {{ section.settings.max_width }}px;

  width: 100%;
  margin: 0 auto;

  display: grid;

  {% if section.settings.image_side == 'right' %}

    grid-template-columns:
      minmax(0, {{ 100 | minus: section.settings.image_width }}fr)
      minmax(0, {{ section.settings.image_width }}fr);

  {% else %}

    grid-template-columns:
      minmax(0, {{ section.settings.image_width }}fr)
      minmax(0, {{ 100 | minus: section.settings.image_width }}fr);

  {% endif %}

  gap: {{ section.settings.column_gap }}px;

  align-items: center;

}

/* =========================================
   CARTE IMAGE
========================================= */

#fp-story-{{ section.id }} .fp-story__media {

  min-width: 0;

  {% if section.settings.image_side == 'right' %}
    order: 2;
  {% else %}
    order: 1;
  {% endif %}

}

#fp-story-{{ section.id }} .fp-story__image-wrapper {

  position: relative;

  width: 100%;
  height: {{ section.settings.image_height }}px;

  border-radius: {{ section.settings.image_radius }}px;

  overflow: hidden;
  isolation: isolate;

  background: #574B40;

}

#fp-story-{{ section.id }} .fp-story__image {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  object-position: {{ section.settings.image_position }};

}

#fp-story-{{ section.id }} .fp-story__placeholder {
  width: 100%;
  height: 100%;
  background: #766651;
}

#fp-story-{{ section.id }} .fp-story__placeholder svg {
  width: 100%;
  height: 100%;
}

/* DÉGRADÉ */

#fp-story-{{ section.id }} .fp-story__overlay {

  position: absolute;
  inset: 0;

  z-index: 1;

  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.35) 0%,
    rgba(0,0,0,0.04) 40%,
    rgba(0,0,0,{{ section.settings.overlay_strength | divided_by: 100.0 }}) 100%
  );

  pointer-events: none;

}

/* CONTENU SUR IMAGE */

#fp-story-{{ section.id }} .fp-story__image-content {

  position: absolute;
  inset: 0;

  z-index: 2;

  padding: {{ section.settings.image_padding }}px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  color: var(--fp-card-text);

  font-family: var(--fp-font);

}

/* GRAND TITRE IMAGE */

#fp-story-{{ section.id }} .fp-story__image-heading {

  font-family: var(--fp-font);

  font-size: {{ section.settings.image_heading_size }}px;

  font-weight: 800;

  line-height: 1.13;

  letter-spacing: -0.045em;

  text-transform: uppercase;

  overflow-wrap: break-word;

  max-width: 100%;

}

/* BAS IMAGE */

#fp-story-{{ section.id }} .fp-story__image-bottom {

  display: flex;
  flex-direction: column;

  align-items: flex-start;

  gap: 7px;

}

#fp-story-{{ section.id }} .fp-story__stars {

  display: flex;
  gap: 3px;

  font-size: 21px;

  line-height: 1;

  color: var(--fp-stars);

}

#fp-story-{{ section.id }} .fp-story__bottom-heading {

  font-family: var(--fp-font);

  font-size: {{ section.settings.bottom_heading_size }}px;

  font-weight: 800;

  line-height: 1.15;

  letter-spacing: -0.035em;

  text-transform: uppercase;

}

#fp-story-{{ section.id }} .fp-story__bottom-description {

  font-family: var(--fp-font);

  font-size: 14px;

  font-weight: 500;

  line-height: 1.5;

  letter-spacing: -0.01em;

}

/* =========================================
   TEXTE PRINCIPAL
========================================= */

#fp-story-{{ section.id }} .fp-story__content {

  min-width: 0;
  width: 100%;

  {% if section.settings.image_side == 'right' %}
    order: 1;
  {% else %}
    order: 2;
  {% endif %}

}

#fp-story-{{ section.id }} .fp-story__main-heading {

  margin: 0 0 {{ section.settings.heading_spacing }}px;

  padding: 0;

  font-family: var(--fp-font);

  font-size: {{ section.settings.main_heading_size }}px;

  font-weight: {{ section.settings.heading_weight }};

  line-height: 1.4;

  letter-spacing: -0.04em;

  color: var(--fp-title);

  overflow-wrap: break-word;

}

/* =========================================
   STATISTIQUES
========================================= */

#fp-story-{{ section.id }} .fp-story__stats {

  width: 100%;

}

#fp-story-{{ section.id }} .fp-story__stat {

  display: grid;

  grid-template-columns:
    minmax(0, {{ section.settings.number_column_width }}px)
    minmax(0, 1fr);

  align-items: center;

  gap: 20px;

  padding: {{ section.settings.row_padding }}px 0;

  border-bottom: 1px solid var(--fp-border);

}

#fp-story-{{ section.id }} .fp-story__stat:first-child {
  padding-top: 0;
}

#fp-story-{{ section.id }} .fp-story__stat:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

/* CHIFFRES */

#fp-story-{{ section.id }} .fp-story__stat-number {

  font-family: var(--fp-font);

  font-size: {{ section.settings.number_size }}px;

  font-weight: 800;

  line-height: 1.1;

  letter-spacing: -0.065em;

  color: var(--fp-title);

  white-space: nowrap;

  font-variant-numeric: tabular-nums;

}

/* TEXTES À DROITE DES CHIFFRES */

#fp-story-{{ section.id }} .fp-story__stat-info {

  display: flex;

  flex-direction: column;

  gap: 6px;

  min-width: 0;

}

#fp-story-{{ section.id }} .fp-story__stat-title {

  font-family: var(--fp-font);

  font-size: {{ section.settings.stat_title_size }}px;

  font-weight: 700;

  line-height: 1.35;

  letter-spacing: -0.035em;

  color: var(--fp-text);

}

#fp-story-{{ section.id }} .fp-story__stat-description {

  font-family: var(--fp-font);

  font-size: {{ section.settings.description_size }}px;

  font-weight: 400;

  line-height: 1.65;

  letter-spacing: -0.015em;

  color: var(--fp-secondary);

}

#fp-story-{{ section.id }} .fp-story__stat-description p {
  margin: 0;
}

#fp-story-{{ section.id }} .fp-story__stat-description a {

  font-weight: 600;

  color: var(--fp-text);

  text-decoration: underline;

  text-underline-offset: 3px;

}

/* =========================================
   RESPONSIVE TABLETTE ET MOBILE
========================================= */

@media screen and (max-width: 989px) {

  #fp-story-{{ section.id }} {

    padding:
      {{ section.settings.mobile_padding_top }}px
      16px
      {{ section.settings.mobile_padding_bottom }}px;

  }

  #fp-story-{{ section.id }} .fp-story__container {

    grid-template-columns: minmax(0, 1fr);

    gap: {{ section.settings.mobile_gap }}px;

  }

  #fp-story-{{ section.id }} .fp-story__media {

    {% if section.settings.mobile_image_first %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}

  }

  #fp-story-{{ section.id }} .fp-story__content {

    {% if section.settings.mobile_image_first %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}

  }

  #fp-story-{{ section.id }} .fp-story__image-wrapper {

    height: {{ section.settings.mobile_image_height }}px;

  }

  #fp-story-{{ section.id }} .fp-story__image-content {

    padding: 24px;

  }

  #fp-story-{{ section.id }} .fp-story__image-heading {

    font-size: {{ section.settings.mobile_image_title_size }}px;

    line-height: 1.15;

    letter-spacing: -0.045em;

  }

  #fp-story-{{ section.id }} .fp-story__main-heading {

    font-size: {{ section.settings.mobile_heading_size }}px;

    line-height: 1.45;

    letter-spacing: -0.035em;

    margin-bottom: 30px;

  }

  #fp-story-{{ section.id }} .fp-story__stat {

    grid-template-columns:
      minmax(0, {{ section.settings.mobile_number_column }}px)
      minmax(0, 1fr);

    gap: 14px;

    padding: 24px 0;

  }

  #fp-story-{{ section.id }} .fp-story__stat-number {

    font-size: {{ section.settings.mobile_number_size }}px;

    font-weight: 800;

    letter-spacing: -0.065em;

  }

  #fp-story-{{ section.id }} .fp-story__stat-title {

    font-size: {{ section.settings.mobile_stat_title_size }}px;

    font-weight: 700;

    line-height: 1.35;

  }

  #fp-story-{{ section.id }} .fp-story__stat-description {

    font-size: {{ section.settings.mobile_description_size }}px;

    line-height: 1.6;

  }

}

/* PETITS ÉCRANS */

@media screen and (max-width: 380px) {

  #fp-story-{{ section.id }} .fp-story__image-content {
    padding: 18px;
  }

  #fp-story-{{ section.id }} .fp-story__stat {
    gap: 10px;
  }

  #fp-story-{{ section.id }} .fp-story__stat-number {
    font-size: min({{ section.settings.mobile_number_size }}px, 9vw);
  }

}

</style>

{% schema %}
{
  "name": "Image et statistiques",
  "tag": "div",
  "class": "section-image-statistiques",
  "settings": [
    {
      "type": "header",
      "content": "Image principale"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo principale"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de la photo",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"}
      ],
      "default": "center center"
    },
    {
      "type": "textarea",
      "id": "image_heading",
      "label": "Grand titre sur la photo",
      "default": "MARQUE DE MINI-BIKES N°1"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Afficher les étoiles",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "label": "Nombre d'étoiles",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "bottom_heading",
      "label": "Titre en bas de la photo",
      "default": "ROULEZ ROBUSTE !"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Sous-titre en bas",
      "default": "De la Corée du Sud à l'Europe"
    },
    {
      "type": "header",
      "content": "Texte principal"
    },
    {
      "type": "textarea",
      "id": "main_heading",
      "label": "Titre principal à droite",
      "default": "Des vélos électriques de caractère, un accompagnement personnalisé et une expérience d'achat sans compromis, directement de nous à vous."
    },
    {
      "type": "header",
      "content": "Typographie Manrope"
    },
    {
      "type": "range",
      "id": "main_heading_size",
      "label": "Taille titre principal PC",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Épaisseur titre principal",
      "options": [
        {"value": "400", "label": "Regular"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi-Bold"},
        {"value": "700", "label": "Bold"},
        {"value": "800", "label": "Extra-Bold"}
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "image_heading_size",
      "label": "Taille titre photo PC",
      "min": 22,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "bottom_heading_size",
      "label": "Taille titre bas photo",
      "min": 14,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Taille chiffres PC",
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "stat_title_size",
      "label": "Taille titres statistiques",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Taille descriptions",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Disposition ordinateur"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur totale",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Position de la photo PC",
      "options": [
        {"value": "left", "label": "À gauche"},
        {"value": "right", "label": "À droite"}
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Largeur photo en pourcentage",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 38
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Hauteur photo PC",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 510
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arrondi des angles photo",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "image_padding",
      "label": "Marges intérieures photo",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Intensité du dégradé sombre",
      "min": 0,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Espace photo / texte",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Espace sous titre principal",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "number_column_width",
      "label": "Largeur colonne chiffres",
      "min": 100,
      "max": 280,
      "step": 5,
      "unit": "px",
      "default": 210
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Espacement statistiques",
      "min": 10,
      "max": 55,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge supérieure PC",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge inférieure PC",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Version mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Afficher la photo en premier",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Hauteur photo mobile",
      "min": 250,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "mobile_image_title_size",
      "label": "Taille titre photo mobile",
      "min": 20,
      "max": 46,
      "step": 1,
      "unit": "px",
      "default": 29
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Taille titre principal mobile",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 23
    },
    {
      "type": "range",
      "id": "mobile_number_size",
      "label": "Taille chiffres mobile",
      "min": 26,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_number_column",
      "label": "Largeur colonne chiffres mobile",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 145
    },
    {
      "type": "range",
      "id": "mobile_stat_title_size",
      "label": "Taille titres stats mobile",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Taille descriptions mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espace image / contenu mobile",
      "min": 10,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Marge supérieure mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Marge inférieure mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond de section",
      "default": "#FFFFFF"
