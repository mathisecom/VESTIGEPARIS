{% comment %}
  Section Shopify : Caractéristiques produits
  6 colonnes sur ordinateur, 3 sur tablette, 2 sur mobile.
  Valeurs, textes et icônes modifiables dans l'éditeur du thème.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  #fp-specs-{{ section.id }} {
    --fp-bg: {{ section.settings.background }};
    --fp-circle: {{ section.settings.circle_background }};
    --fp-title-color: {{ section.settings.value_color }};
    --fp-label-color: {{ section.settings.label_color }};
    --fp-accent: {{ section.settings.accent_color }};
    --fp-icon-size: {{ section.settings.circle_size }}px;
    background: var(--fp-bg);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: 'Manrope', sans-serif !important;
  }

  #fp-specs-{{ section.id }} *,
  #fp-specs-{{ section.id }} *::before,
  #fp-specs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #fp-specs-{{ section.id }} .fp-specs__container {
    width: 100%;
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
  }

  #fp-specs-{{ section.id }} .fp-specs__heading {
    margin: 0 0 34px;
    color: var(--fp-title-color);
    font-family: 'Manrope', sans-serif !important;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    text-align: center;
  }

  #fp-specs-{{ section.id }} .fp-specs__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
    gap: 26px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #fp-specs-{{ section.id }} .fp-specs__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: 'Manrope', sans-serif !important;
  }

  #fp-specs-{{ section.id }} .fp-specs__circle {
    display: flex;
    width: var(--fp-icon-size);
    height: var(--fp-icon-size);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    border-radius: 50%;
    background: var(--fp-circle);
    color: #262626;
  }

  #fp-specs-{{ section.id }} .fp-specs__circle svg {
    display: block;
    width: 52%;
    height: 52%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #fp-specs-{{ section.id }} .fp-specs__image {
    display: block;
    width: 58%;
    height: 58%;
    object-fit: contain;
  }

  #fp-specs-{{ section.id }} .fp-specs__value {
    display: block;
    margin: 0 0 12px;
    color: var(--fp-title-color);
    font-family: 'Manrope', sans-serif !important;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  #fp-specs-{{ section.id }} .fp-specs__label {
    display: block;
    margin: 0;
    color: var(--fp-label-color);
    font-family: 'Manrope', sans-serif !important;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 990px) and (min-width: 750px) {
    #fp-specs-{{ section.id }} .fp-specs__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 34px;
    }
  }

  @media screen and (max-width: 749px) {
    #fp-specs-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
    }

    #fp-specs-{{ section.id }} .fp-specs__heading {
      margin-bottom: 26px;
      font-size: 24px;
    }

    #fp-specs-{{ section.id }} .fp-specs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
      row-gap: 26px;
    }

    #fp-specs-{{ section.id }} .fp-specs__circle {
      margin-bottom: 20px;
    }

    #fp-specs-{{ section.id }} .fp-specs__value {
      margin-bottom: 6px;
      font-size: 16px;
    }

    #fp-specs-{{ section.id }} .fp-specs__label {
      font-size: 12px;
    }
  }
</style>

<section id="fp-specs-{{ section.id }}" class="fp-specs" aria-label="Caractéristiques techniques">
  <div class="fp-specs__container">
    {% if section.settings.heading != blank %}
      <h2 class="fp-specs__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <ul class="fp-specs__grid">
      {% for block in section.blocks %}
        <li class="fp-specs__item" {{ block.shopify_attributes }}>
          <div class="fp-specs__circle" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 180 | image_tag: loading: 'lazy', class: 'fp-specs__image', alt: '' }}
            {% else %}
              {% case block.settings.icon %}
                {% when 'motor' %}
                  <svg viewBox="0 0 64 64" focusable="false">
                    <circle cx="32" cy="32" r="26" stroke="#8c8c8c" stroke-width="1.4"/>
                    <path d="M36 11 23 34h10l-5 19 15-26H32z" fill="var(--fp-accent)" stroke="none"/>
                  </svg>
                {% when 'speed' %}
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M10 40a22 22 0 0 1 44 0" stroke="#909090"/>
                    <path d="M18 38a14 14 0 0 1 28-4" stroke="var(--fp-accent)" stroke-width="3.5"/>
                    <path d="m34 41 10-15" stroke="var(--fp-accent)" stroke-width="3.5"/>
                    <circle cx="32" cy="43" r="4.5" fill="#fff" stroke="var(--fp-accent)" stroke-width="3"/>
                  </svg>
                {% when 'battery' %}
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="19" y="11" width="26" height="45" rx="4" stroke-width="3"/>
                    <path d="M28 7h8" stroke-width="3.5"/>
                    <path d="M26 22h12M26 30h12M26 38h12M26 46h12" stroke="var(--fp-accent)" stroke-width="3"/>
                  </svg>
                {% when 'range' %}
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M17 24c-8 0-8-17 0-17s8 17 0 17Z" fill="#141414" stroke="none"/>
                    <circle cx="17" cy="15" r="2.7" fill="#fff" stroke="none"/>
                    <path d="M47 54c-8 0-8-17 0-17s8 17 0 17Z" fill="#141414" stroke="none"/>
                    <circle cx="47" cy="45" r="2.7" fill="#fff" stroke="none"/>
                    <path d="M17 24v5c0 7 8 6 14 6s7 2 7 8" stroke="var(--fp-accent)" stroke-width="1.8" stroke-dasharray="2 4"/>
                    <path d="M17 24 17 29M47 54l-1 3" stroke="#141414" stroke-width="2"/>
                  </svg>
                {% when 'load' %}
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M25 16v-4a7 7 0 0 1 14 0v4" stroke="#7b7b7b" stroke-width="1.7"/>
                    <path d="M21 19h22l8 30a5 5 0 0 1-5 6H18a5 5 0 0 1-5-6z" fill="#fff" stroke="#777" stroke-width="1.8"/>
                    <text x="32" y="42" font-family="Manrope, sans-serif" font-size="14" font-weight="800" text-anchor="middle" stroke="none" fill="var(--fp-accent)">KG</text>
                  </svg>
                {% when 'charge' %}
                  <svg viewBox="0 0 64 64" focusable="false">
                    <rect x="11" y="14" width="25" height="42" rx="3" stroke-width="3"/>
                    <path d="M19 9h9" stroke-width="3"/>
                    <path d="m27 22-10 17h9l-3 12 11-19h-9z" fill="var(--fp-accent)" stroke="none"/>
                    <path d="M36 27h7v18c0 7 12 7 12 0V27" stroke="#777" stroke-width="1.7"/>
                    <path d="M50 21v-6m6 6v-6M48 21h10v9H48z" stroke="#777" stroke-width="1.7"/>
                  </svg>
              {% endcase %}
            {% endif %}
          </div>
          <strong class="fp-specs__value">{{ block.settings.value | escape }}</strong>
          <span class="fp-specs__label">{{ block.settings.label | escape }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Caractéristiques produit",
  "tag": "div",
  "class": "shopify-section--fp-specs",
  "settings": [
    { "type": "header", "content": "Présentation" },
    { "type": "text", "id": "heading", "label": "Titre (facultatif)" },
    { "type": "range", "id": "section_width", "label": "Largeur maximale PC", "min": 900, "max": 1500, "step": 50, "default": 1300, "unit": "px" },
    { "type": "range", "id": "circle_size", "label": "Taille des cercles", "min": 64, "max": 112, "step": 8, "default": 88, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Espacement haut PC", "min": 0, "max": 120, "step": 5, "default": 35, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Espacement bas PC", "min": 0, "max": 120, "step": 5, "default": 35, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Espacement haut mobile", "min": 0, "max": 120, "step": 5, "default": 20, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espacement bas mobile", "min": 0, "max": 120, "step": 5, "default": 20, "unit": "px" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond de section", "default": "#FFFFFF" },
    { "type": "color", "id": "circle_background", "label": "Fond des cercles", "default": "#F3F3F3" },
    { "type": "color", "id": "accent_color", "label": "Accent des icônes", "default": "#C94B50" },
    { "type": "color", "id": "value_color", "label": "Valeur", "default": "#181818" },
    { "type": "color", "id": "label_color", "label": "Description", "default": "#383838" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Caractéristique",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "motor", "label": "Moteur (éclair)" },
          { "value": "speed", "label": "Vitesse (compteur)" },
          { "value": "battery", "label": "Batterie" },
          { "value": "range", "label": "Autonomie (trajet)" },
          { "value": "load", "label": "Charge maximale" },
          { "value": "charge", "label": "Temps de recharge" }
        ], "default": "motor" },
        { "type": "image_picker", "id": "icon_image", "label": "Icône personnalisée (facultative)", "info": "Remplace l'icône sélectionnée. PNG transparent conseillé." },
        { "type": "text", "id": "value", "label": "Valeur", "default": "350 W" },
        { "type": "text", "id": "label", "label": "Description", "default": "Puissance du moteur" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Caractéristiques produit",
      "blocks": [
        { "type": "spec", "settings": { "icon": "motor", "value": "350 W", "label": "Puissance du moteur" } },
        { "type": "spec", "settings": { "icon": "speed", "value": "31 km/h", "label": "Vitesse maximale" } },
        { "type": "spec", "settings": { "icon": "battery", "value": "36 V / 7,8 Ah", "label": "Capacité de batterie" } },
        { "type": "spec", "settings": { "icon": "range", "value": "29 km", "label": "Autonomie" } },
        { "type": "spec", "settings": { "icon": "load", "value": "100 kg", "label": "Charge maximale" } },
        { "type": "spec", "settings": { "icon": "charge", "value": "5 à 6 h", "label": "Temps de charge" } }
      ]
    }
  ]
}
{% endschema %}