      "type": "faqstyle",
      "blocks": {
        "question_cMQEc8": {
          "type": "question",
          "settings": {
            "category": "livraison",
            "question": "Où livrez-vous vos produits ?",
            "answer": "<p>Les zones de livraison disponibles sont indiquées au moment de la validation de votre commande. Les frais éventuels sont calculés selon votre destination.</p>"
          }
        },
        "question_zEmLx4": {
          "type": "question",
          "settings": {
            "category": "livraison",
            "question": "Quels sont les délais de livraison ?",
            "answer": "<p>Les délais estimés dépendent du produit, de son stock et de votre adresse. L'estimation applicable est indiquée lors de votre commande.</p>"
          }
        },
        "question_i8Rk6z": {
          "type": "question",
          "settings": {
            "category": "livraison",
            "question": "Comment suivre ma commande ?",
            "answer": "<p>Lorsqu'un suivi est disponible, vous recevez les informations d'expédition par e-mail. Vous pouvez également contacter notre service client avec votre numéro de commande.</p>"
          }
        },
        "question_LbPiYG": {
          "type": "question",
          "settings": {
            "category": "livraison",
            "question": "Comment mon produit est-il emballé ?",
            "answer": "<p>Votre produit est préparé dans un emballage adapté à son transport. Vérifiez l'état du colis lors de la réception et signalez rapidement tout dommage.</p>"
          }
        },
        "question_JhG9wq": {
          "type": "question",
          "settings": {
            "category": "paiement",
            "question": "Quels moyens de paiement acceptez-vous ?",
            "answer": "<p>Les moyens de paiement disponibles sont affichés lors du passage en caisse, avant la validation définitive de la commande.</p>"
          }
        },
        "question_d6Q8z9": {
          "type": "question",
          "settings": {
            "category": "paiement",
            "question": "Le paiement sur votre site est-il sécurisé ?",
            "answer": "<p>Le paiement est traité par les prestataires proposés à la caisse. Vérifiez les moyens de paiement et les informations affichées avant de confirmer votre achat.</p>"
          }
        },
        "question_yGpBTn": {
          "type": "question",
          "settings": {
            "category": "paiement",
            "question": "Puis-je modifier ou annuler ma commande ?",
            "answer": "<p>Contactez notre service client au plus vite avec votre numéro de commande. Les possibilités de modification ou d'annulation dépendent de l'état de préparation et d'expédition.</p>"
          }
        },
        "question_xM7XpR": {
          "type": "question",
          "settings": {
            "category": "paiement",
            "question": "Comment obtenir une facture ?",
            "answer": "<p>Pour toute demande de facture, contactez notre service client en indiquant votre numéro de commande et les informations de facturation nécessaires.</p>"
          }
        },
        "question_rwtWBH": {
          "type": "question",
          "settings": {
            "category": "garantie",
            "question": "Que faire si mon produit arrive endommagé ?",
            "answer": "<p>Contactez notre service client dès que possible, avec votre numéro de commande et des photos du colis et du produit. Nous vous indiquerons la marche à suivre.</p>"
          }
        },
        "question_cQcWye": {
          "type": "question",
          "settings": {
            "category": "garantie",
            "question": "Quelle garantie s'applique à mon produit ?",
            "answer": "<p>Les garanties légales applicables restent en vigueur. Les éventuelles garanties commerciales et leurs conditions sont précisées sur la fiche produit ou dans nos conditions de garantie.</p>"
          }
        },
        "question_gnP4nL": {
          "type": "question",
          "settings": {
            "category": "garantie",
            "question": "Comment contacter le service après-vente ?",
            "answer": "<p>Utilisez la page de contact de notre boutique en précisant votre numéro de commande, le modèle concerné et une description de votre demande.</p>"
          }
        },
        "question_UDnEqz": {
          "type": "question",
          "settings": {
            "category": "garantie",
            "question": "Puis-je retourner un article ?",
            "answer": "<p>Consultez notre politique de retour pour connaître les conditions et la procédure applicables, ainsi que vos droits légaux éventuels. Contactez-nous avant tout renvoi.</p>"
          }
        },
        "question_JWxN6d": {
          "type": "question",
          "settings": {
            "category": "produits",
            "question": "Que comprend cet ensemble ?",
            "answer": "<p>L’ensemble comprend un antivol à chaîne et deux menottes, trois clés et un sac de rangement de 3 litres.</p>"
          }
        },
        "question_N9YHi8": {
          "type": "question",
          "settings": {
            "category": "produits",
            "question": "Quelle est la longueur de l’antivol ?",
            "answer": "<p>La longueur totale annoncée est de 90 cm, dont 60 cm de chaîne.</p>"
          }
        },
        "question_rxnw3N": {
          "type": "question",
          "settings": {
            "category": "produits",
            "question": "Est-il compatible avec mon véhicule ?",
            "answer": "<p>La compatibilité dépend des dimensions du cadre ou de la zone d’attache et du point fixe choisi. Vérifiez l’espace disponible avant l’achat.</p>"
          }
        },
        "question_zhUXwj": {
          "type": "question",
          "settings": {
            "category": "produits",
            "question": "Comment l’utiliser au quotidien ?",
            "answer": "<p>Attachez une partie structurelle du véhicule à un point fixe solide, vérifiez la fermeture des deux menottes et conservez une clé de secours séparément. Aucun antivol ne garantit une protection absolue contre le vol.</p>"
          }
