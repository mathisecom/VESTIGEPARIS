          "type": "question",
          "settings": {
            "category": "produits",
            "question": "Quelle distance peut-elle parcourir ?",
            "answer": "<p>L’autonomie annoncée est de 20 km maximum. Elle varie avec la charge, la vitesse, le relief et la température.</p>"
          }
        },
